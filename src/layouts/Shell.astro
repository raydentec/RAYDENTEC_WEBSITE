---
/**
 * App shell (HANDOFF §0, §3). Everything except the content column is
 * `transition:persist`-ed, so ClientRouter navigation only swaps the column:
 * the background video keeps looping and the sidebar/rail/nav/menus keep state.
 */
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import MobileHeader from '../components/MobileHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Nav from '../components/Nav.astro';
import Profile from '../components/Profile.astro';
import Rail from '../components/Rail.astro';
import ScrollControl from '../components/ScrollControl.astro';
import Sidebar from '../components/Sidebar.astro';
import { getSite, type PageId } from '../lib/content';

interface Props {
  page: PageId;
  /** Render a visually hidden <h1> (pages whose first container has no h1). */
  srHeading?: boolean;
  /** The containers are sideways-scrolling rows of games on desktop/tablet (Games). */
  rows?: boolean;
}

const { page, srHeading = true, rows = false } = Astro.props;
const site = await getSite();
const pageLabel = site.pages.find((p) => p.id === page)?.label ?? '';
const title = page === 'start' ? `${site.name} · ${site.tagline}` : `${pageLabel} · ${site.name}`;
---

<!doctype html>
<html lang="en" data-sidebar="expanded" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={site.bio} />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="preload" href="/assets/fonts/sora-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/sora-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/chakra-petch-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/fonts/fonts.css" />
    <ClientRouter />
  </head>
  <body>
    <!-- Decorative lightning loop (HANDOFF §2.1); src is chosen by scripts/bg-video.ts. -->
    <video
      class="bg-video"
      id="bgVideo"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      poster="/assets/video/lightning-mobile-poster.jpg"
      transition:persist="bg-video"></video>
    <div class="top-bar" aria-hidden="true"></div>

    <Nav current={page} />
    <Rail />
    <Sidebar />
    <MobileHeader />

    <main
      id="scroller"
      class:list={['scroller', { 'scroller--rows': rows }]}
      aria-label={`${pageLabel} content`}
      data-page={page}
      data-snap="off"
      transition:name={rows ? 'scroller-rows' : 'scroller'}
      transition:animate={fade({ duration: '160ms' })}
    >
      <div class="mprofile" data-mprofile>
        <Profile />
        <div class="mprofile__spacer" aria-hidden="true"></div>
      </div>
      {srHeading && <h1 class="sr-only">{pageLabel}</h1>}
      <div class="column" data-column>
        <slot />
      </div>
    </main>

    <div class="track" aria-hidden="true" transition:persist="scroll-track">
      <div class="track__thumb" data-track-thumb></div>
    </div>
    <ScrollControl />
    <MobileMenu current={page} />
    <Footer />

    <script>
      import '../scripts/bg-video';
      import '../scripts/sidebar';
      import '../scripts/snap';
      import '../scripts/scroll-control';
      import '../scripts/mobile-menu';
      import '../scripts/wheel';
      import '../scripts/game-rows';
    </script>
  </body>
</html>

<style>
  /* ---------- Content column (the only thing that scrolls on desktop/tablet) ---------- */
  .scroller {
    position: fixed;
    top: var(--content-top);
    /* Runs down to the footer rule, so content is clipped there (as on mobile).
       Rail, sidebar, track and scroll control still align to --content-bottom. */
    bottom: var(--footer-h);
    /* Collapsed: re-centered on the viewport. */
    left: calc((100vw - var(--content-w)) / 2);
    width: var(--content-w);
    overflow: hidden auto;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    z-index: 1;
    transition:
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  .scroller::-webkit-scrollbar {
    display: none;
  }
  /* Snapping paused while wheel input from outside the column is forwarded (scripts/wheel.ts). */
  :global(.scroller[data-wheel]) {
    scroll-snap-type: none !important;
  }
  .scroller:focus {
    outline: none;
  }
  /* Desktop, sidebar expanded: column sits right of the sidebar (x = 416). */
  @media (min-width: 1280px) {
    :global(html[data-sidebar='expanded']) .scroller {
      left: var(--col-left-expanded);
      width: var(--content-w-expanded);
    }
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    /* Lets the last container snap to the top too (set by scripts/snap.ts). */
    padding-bottom: var(--tail, 0px);
  }

  .mprofile {
    display: none;
  }

  /* ---------- Scroll track ---------- */
  .track {
    position: fixed;
    right: var(--track-right);
    top: var(--content-top);
    bottom: var(--content-bottom);
    width: var(--track-w);
    background: rgba(255, 255, 255, 0.06);
    z-index: 1;
    pointer-events: none;
  }
  .track__thumb {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0;
    background: var(--c-red);
    will-change: transform;
  }

  /*
   * ---------- Rows of games (Games, desktop/tablet) ----------
   * The column scrolls vertically between rows like everywhere else, but spans the whole
   * window so each row (GameRow.astro) can run out to the right edge; on the left it is
   * cut off at the rail's / sidebar's edge (--clip-left). Rows line their games up with
   * the usual column (--row-left, --row-w).
   *
   * Opening / closing the sidebar animates these variables themselves (registered below),
   * so the rows' padding, widths and snap position (scroll-padding) all move together and
   * the games glide over like the column on other pages. Animating the padding alone left
   * the snap position to change at once, and the rows jumped to it.
   */
  @property --row-left {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  @property --row-w {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  @property --clip-left {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  @media (min-width: 768px) {
    .scroller--rows {
      --row-left: calc((100vw - var(--content-w)) / 2);
      --row-w: var(--content-w);
      --clip-left: calc(var(--gutter) + var(--rail-w));
      left: 0;
      width: 100%;
      clip-path: inset(0 0 0 var(--clip-left));
      transition:
        --row-left var(--t-sidebar) var(--ease-out),
        --row-w var(--t-sidebar) var(--ease-out),
        --clip-left var(--t-sidebar) var(--ease-out);
    }
    /* Rows one game button's height apart (the card buttons: 56px, 52px on tablet). */
    .scroller--rows .column {
      gap: 56px;
    }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .scroller--rows .column {
      gap: 52px;
    }
  }
  @media (min-width: 1280px) {
    /* Sidebar open: the column sits right of it; games are cut off at the sidebar's edge. */
    :global(html[data-sidebar='expanded']) .scroller--rows {
      --row-left: var(--col-left-expanded);
      --row-w: var(--content-w-expanded);
      --clip-left: calc(var(--gutter) + var(--sidebar-w));
      left: 0;
      width: 100%;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 767px) {
    .scroller {
      top: var(--top-bar);
      bottom: var(--footer-h);
      left: 0;
      width: 100%;
      padding: 24px var(--gutter) 0;
      /* Containers snap just below the fixed header line. */
      scroll-padding-top: calc(var(--header-h) - var(--top-bar));
      transition: none;
    }
    /* Content scrolls under the header and is clipped at its bottom edge. */
    :global(html[data-mheader='on']) .scroller {
      clip-path: inset(calc(var(--header-h) - var(--top-bar)) 0 0 0);
    }
    /*
     * Profile area: scrolls freely (no snap point). Snapping is switched off by
     * scripts/snap.ts (data-snap="off") until container 1 is about to activate.
     * At the top only the profile shows: it fills the scroll area down to the footer.
     */
    :global(.scroller[data-snap='off']) {
      scroll-snap-type: none;
    }
    .mprofile {
      display: flex;
      flex-direction: column;
      min-height: calc(100dvh - var(--top-bar) - var(--footer-h) - 24px);
    }
    /* Empty space the size of the controls above the footer (menu bar + SCROLL /
       back-to-top + gaps) + 16px, so the CTAs can scroll clear of them. Small enough
       that the profile's min-height wins on regular phones: container 1's top then sits
       exactly on the footer's top edge at the top of the page. */
    .mprofile__spacer {
      flex-shrink: 0;
      margin-top: auto;
      height: calc(var(--ctl-bottom) - var(--footer-h) + var(--ctl-h) + 16px);
    }
    .column {
      padding-bottom: max(var(--tail, 0px), calc(var(--ctl-bottom) - var(--footer-h) + var(--ctl-h) + 16px));
    }
    .track {
      top: var(--header-h);
      bottom: calc(var(--menu-bar-bottom) + var(--ctl-h) + 2px);
      opacity: 0;
      transition: opacity var(--t-fade) ease;
    }
    :global(html[data-mheader='on']) .track {
      opacity: 1;
    }
  }
</style>
