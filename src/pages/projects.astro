---
import ContainerFrame from '../components/ContainerFrame.astro';
import FilterButton from '../components/FilterButton.astro';
import FilterPanel from '../components/FilterPanel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Shell from '../layouts/Shell.astro';
import { getItems, newestFirst } from '../lib/content';
import { projectCategories } from '../lib/project-categories';

const items = (await getItems('projects')).map(({ data }) => data);

// One group per category (by category order, lib/project-categories.ts — as the filter
// buttons), each headed by its category name, its
// projects newest first; containers are numbered across groups (scripts/project-filter.ts
// renumbers when filtering).
let index = 0;
const groups = projectCategories
  .map((category) => ({
    category,
    projects: items
      .filter((p) => p.category === category)
      .sort(newestFirst)
      .map((data) => ({ data, index: index++ })),
  }))
  .filter((g) => g.projects.length > 0);
---

<Shell page="projects">
  {
    groups.map((g) => (
      <section class="pgroup" data-category={g.category} aria-labelledby={`projects-${g.category}`}>
        <h2 class="pgroup__title" id={`projects-${g.category}`} style={`--cf-i: ${g.projects[0].index}`}>
          {g.category}
        </h2>
        {g.projects.map(({ data, index }) => (
          <ContainerFrame index={index} variant="project" number={index + 1} active={index === 0} label={data.title}>
            <ProjectCard {...data} />
          </ContainerFrame>
        ))}
      </section>
    ))
  }
  <FilterPanel slot="overlay" />
  <FilterButton />
</Shell>

<style>
  /*
   * Each category headline has no snap point of its own: it rides along with the
   * container below it — that container's scroll-margin-top reaches up to the headline,
   * so it snaps with it on top (CSS snapping, and the scripts via dom.ts snapTop). Sizes
   * are fixed so the margin can be computed here: --title-size (headline, line-height 1),
   * --title-gap (headline → container), --title-top (extra space above a headline, on top
   * of the column gap). The category filter is a panel over the content (FilterPanel.astro).
   */
  .pgroup {
    --title-size: 30px;
    --title-gap: 12px;
    --title-top: 20px;
  }

  .pgroup:not([hidden]) {
    display: contents;
  }
  /* Headline: dimmed with its container while that isn't selected. */
  .pgroup__title {
    margin: var(--title-top) 0 calc(var(--title-gap) - var(--card-gap));
    font-weight: 700;
    font-size: var(--title-size);
    line-height: 1;
    letter-spacing: -0.03em;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
    animation: p-fade-in 600ms var(--ease-out) both;
    animation-delay: calc(min(var(--cf-i, 0) + 1, 8) * 180ms);
  }
  .pgroup__title:has(+ :global(.cf.is-active)),
  .pgroup__title:has(+ :global(.cf:hover)),
  .pgroup__title:has(+ :global(.cf:focus-within)) {
    opacity: 1;
  }
  @keyframes p-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pgroup__title {
      animation: none;
    }
  }

  /* The first headline shown starts the column (no space above it). */
  .pgroup:not([hidden]):not(.pgroup:not([hidden]) ~ .pgroup) .pgroup__title {
    margin-top: 0;
  }

  /* Snap edges: the headline rides with the group's first container. */
  .pgroup__title + :global(.cf) {
    scroll-margin-top: calc(var(--title-size) + var(--title-gap));
  }

  @media (max-width: 1279px) {
    .pgroup {
      --title-size: 26px;
    }
  }
  @media (max-width: 767px) {
    .pgroup {
      --title-size: 24px;
    }
  }
</style>
