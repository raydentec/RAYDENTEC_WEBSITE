---
import CommunityCard from '../components/CommunityCard.astro';
import ContainerFrame from '../components/ContainerFrame.astro';
import GameRow from '../components/GameRow.astro';
import LinkGrid from '../components/LinkGrid.astro';
import ShortcutGrid from '../components/ShortcutGrid.astro';
import Shell from '../layouts/Shell.astro';
import { getItems } from '../lib/content';

const items = (await getItems('community')).map(({ data }) => data);

type Item = (typeof items)[number];
type Link = Exclude<Item, { type: 'linkGrid' }>;

// Links: every link item (JSON order) as its own numbered card in a sideways row, as the
// Games rows (GameRow.astro), at the end of the page; the "More ways to connect" grid keeps a
// container of its own above it, headed like Social Accounts (as the Projects category
// headlines).
const links = items.filter((i): i is Link => i.type !== 'linkGrid');
const grids = items.filter((i): i is Extract<Item, { type: 'linkGrid' }> => i.type === 'linkGrid');

// Shortcuts: the first ten link items (JSON order) as tiles, in a container of their own
// at the top, headed "Shortcuts" (as the Projects category headlines).
const shortcuts = links.slice(0, 10);
---

<Shell page="community" rows>
  <h2 class="ctitle" id="community-shortcuts">Social Accounts</h2>
  <ContainerFrame index={0} variant="community" active fit bare noTab label="Social Accounts">
    <ShortcutGrid links={shortcuts} />
  </ContainerFrame>
  {
    grids.map((g, i) => [
      <h2 class="ctitle ctitle--more" id={`community-more-${i}`} data-cf-head>{g.title}</h2>,
      <ContainerFrame index={i + 1} variant="community" fit noTab bare label={g.title}>
        <LinkGrid links={g.links} />
      </ContainerFrame>,
    ])
  }
  <GameRow title="Links" titles={links.map((l) => l.title)} index={1} row={grids.length + 1} itemsLabel="Links" class="crow">
    {
      links.map((l, i) => (
        <ContainerFrame index={grids.length + i + 1} variant="game" number={i + 1} label={l.title}>
          <CommunityCard {...l} framed />
        </ContainerFrame>
      ))
    }
  </GameRow>
</Shell>

<style>
  /*
   * "Shortcuts" headline: as the Projects category headlines — it rides along with the
   * container below it (that container's scroll-margin-top reaches up to it, so it snaps
   * with it on top) and is dimmed while that container isn't selected.
   */
  .ctitle {
    --title-size: 30px;
    --title-gap: 12px;
    font-weight: 700;
    font-size: var(--title-size);
    line-height: 1;
    letter-spacing: -0.03em;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
    animation: c-fade-in 600ms var(--ease-out) 180ms backwards;
  }
  .ctitle:has(+ :global(.cf.is-active)),
  .ctitle:has(+ :global(.cf:hover)),
  .ctitle:has(+ :global(.cf:focus-within)) {
    opacity: 1;
  }
  .ctitle + :global(.cf) {
    scroll-margin-top: calc(30px + 12px);
  }
  @keyframes c-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctitle {
      animation: none;
    }
  }
  @media (max-width: 1279px) {
    .ctitle {
      --title-size: 26px;
    }
    .ctitle + :global(.cf) {
      scroll-margin-top: calc(26px + 12px);
    }
  }
  @media (max-width: 767px) {
    .ctitle {
      --title-size: 24px;
    }
    .ctitle + :global(.cf) {
      scroll-margin-top: calc(24px + 12px);
    }
  }

  /*
   * The column spans the window (Shell rows), so the rows' cards run edge to edge; the
   * Shortcuts headline and the plain containers are boxed to the usual column (--row-left /
   * --row-w, as the rows' headlines). Containers sit as far apart as the rows (Shell.astro:
   * 56px, tablet 52px; mobile the container gap), so the headline's offset uses that gap.
   */
  .ctitle {
    --col-gap: 56px;
    margin-bottom: calc(var(--title-gap) - var(--col-gap));
  }
  @media (min-width: 768px) {
    .ctitle,
    :global([data-page='community'] .column > .cf) {
      margin-left: var(--row-left);
      width: var(--row-w);
    }
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .ctitle {
      --col-gap: 52px;
    }
  }
  @media (max-width: 767px) {
    .ctitle {
      --col-gap: var(--card-gap);
    }
  }

  /* Social accounts: a translucent black background behind the tiles, as the Start hero's
     lower third (LowerThird.astro; no border), the grid padded inside it (ShortcutGrid.astro). */
  #community-shortcuts + :global(.cf .cf__body) {
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  #community-shortcuts + :global(.cf .sc) {
    padding: 28px;
  }
  @media (max-width: 1279px) {
    #community-shortcuts + :global(.cf .sc) {
      padding: 24px;
    }
  }
  @media (max-width: 767px) {
    #community-shortcuts + :global(.cf .sc) {
      padding: 14px;
    }
  }

  /*
   * More ways to connect: while not selected it works as an unselected Games row — dimmed
   * (also when hovered), its tiles out of reach, and the whole section, headline included
   * (data-cf-head, scripts/snap.ts), one click target that scrolls it into place.
   */
  .ctitle--more:has(+ :global(.cf:not(.is-active))) {
    opacity: var(--o-inactive);
    cursor: pointer;
  }
  .ctitle--more + :global(.cf:not(.is-active)) {
    cursor: pointer;
  }
  .ctitle--more + :global(.cf:not(.is-active) > *) {
    pointer-events: none;
  }
  .ctitle--more + :global(.cf:not(.is-active) .lg) {
    opacity: var(--o-inactive);
  }
  /*
   * Its box: translucent black with a blur, as Social Accounts (and the Start lower third),
   * as tall as its tiles, padded inside it as the Social Accounts tiles (28px / 24px / 14px).
   */
  .ctitle--more.ctitle--more + :global(.cf .cf__body) {
    background: rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .ctitle--more + :global(.cf .lg) {
    justify-content: flex-start;
    padding: 28px;
  }
  @media (max-width: 1279px) {
    .ctitle--more + :global(.cf .lg) {
      padding: 24px;
    }
  }
  @media (max-width: 767px) {
    .ctitle--more + :global(.cf .lg) {
      padding: 14px;
    }
  }

  /* Main links: all cards as tall as the tallest; the card fills its frame's body so its
     button sits at the bottom (as the Start explore row). Desktop / tablet: cards half the
     content column wide, their bodies at least as tall as a standard container (--card-h),
     the extra room going between the text and the button. */
  :global(.crow .grow__list) {
    align-items: stretch;
  }
  @media (min-width: 768px) {
    :global(.crow.crow) {
      --game-w: calc(var(--row-w) / 2);
    }
    /* Indicator as wide as one card (GameRow's is half a game). */
    :global(.crow .grow__dots) {
      width: var(--game-w);
    }
    :global(.crow .grow__list > .cf > .cf__body) {
      min-height: var(--card-h);
    }
  }
  :global(.crow .grow__list > .cf) {
    display: flex;
    flex-direction: column;
  }
  :global(.crow .grow__list > .cf > .cf__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }
  :global(.crow .grow__list > .cf .cf__content) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    height: auto;
  }
</style>
