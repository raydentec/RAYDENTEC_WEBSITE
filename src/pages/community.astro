---
import CommunityCard from '../components/CommunityCard.astro';
import ContainerFrame from '../components/ContainerFrame.astro';
import LinkGrid from '../components/LinkGrid.astro';
import Shell from '../layouts/Shell.astro';
import { getItems } from '../lib/content';

const items = await getItems('community');
---

<Shell page="community">
  {
    items.map(({ data }, i) => (
      <ContainerFrame variant="community" number={i + 1} active={i === 0} label={data.title}>
        {data.type === 'linkGrid' ? <LinkGrid {...data} /> : <CommunityCard {...data} />}
      </ContainerFrame>
    ))
  }
</Shell>
