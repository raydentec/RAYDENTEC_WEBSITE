---
/**
 * One legal document (src/content/legal/<slug>.md): ← BACK TO LEGAL above one long
 * container, as wide as its top tab (a game card's tab width), then in the container the
 * title with what it applies to, the last-updated date and the document's text (LegalProse).
 */
import { getCollection, render } from 'astro:content';
import BackButton from '../../components/BackButton.astro';
import ContainerFrame from '../../components/ContainerFrame.astro';
import LegalProse from '../../components/LegalProse.astro';
import Shell from '../../layouts/Shell.astro';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const name = `${doc.data.title} (${doc.data.subject})`;
---

<Shell page="legal" label={name} srHeading={false} backToTopOnly>
  <BackButton href="/legal" label="BACK TO LEGAL" class="ldoc__back" />
  <ContainerFrame index={0} variant="start" active label={name}>
    <article class="ldoc">
      <header class="ldoc__head">
        <h1 class="ldoc__title">
          {doc.data.title} <span class="ldoc__subject">({doc.data.subject})</span>
        </h1>
        <p class="ldoc__updated">Last updated {doc.data.updated}</p>
      </header>
      <LegalProse>
        <Content />
      </LegalProse>
    </article>
  </ContainerFrame>
</Shell>

<script>
  /**
   * In-document links (the table of contents, "see section …"): the content column is what
   * scrolls here, not the window, so scroll it to the heading ourselves — just below the
   * snap line (the heading's scroll-margin-top). The URL hash follows for sharing / back.
   */
  import { getScroller, scrollBehavior, snapOffset } from '../../scripts/dom';

  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('.prose a[href^="#"]');
    const scroller = getScroller();
    if (!link || !scroller || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
    const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (!target) return;
    e.preventDefault();
    e.stopPropagation();
    const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const line = scroller.getBoundingClientRect().top + snapOffset(scroller);
    scroller.scrollBy({ top: target.getBoundingClientRect().top - line - margin, behavior: scrollBehavior() });
    history.replaceState(history.state, '', link.hash);
  }, { capture: true });
</script>

<style>
  /*
   * Top tab as wide as a game card's (GameCard rows: half a game, ⅓ of the column) while
   * selected; the usual notch otherwise. Mobile: full width when selected, as everywhere.
   */
  @media (min-width: 768px) {
    :global(#scroller .cf.cf--start.is-active .cf__tab) {
      width: calc(100% / 3);
    }
  }
  /*
   * Desktop / tablet: the last container ends a container gap (--card-gap, as between the
   * Projects containers) above the footer when scrolled to the end; the space is part of
   * the container, so the column can scroll into it. Mobile: the frame, as the page's last
   * container, already ends at the top of the BACK TO TOP control (ContainerFrame.astro).
   */
  @media (min-width: 768px) {
    :global(#scroller .cf:last-child) {
      padding-bottom: var(--card-gap);
    }
  }
  /*
   * ← BACK TO LEGAL sits above the container's tab (as the headlines on the Legal page),
   * --back-gap above it, and as wide as the tab: ⅓ of the column (mobile: the tab spans the
   * container, so does the button). It rides along when the container snaps.
   */
  :global(.column > .back-btn.ldoc__back) {
    --back-gap: 12px;
    flex-shrink: 0;
    width: calc(100% / 3);
    min-width: 0;
    margin-bottom: calc(var(--back-gap) - var(--card-gap));
  }
  :global(.column > .back-btn.ldoc__back + .cf) {
    scroll-margin-top: calc(56px + 12px);
  }
  @media (max-width: 1279px) {
    :global(.column > .back-btn.ldoc__back + .cf) {
      scroll-margin-top: calc(52px + 12px);
    }
  }
  @media (max-width: 767px) {
    :global(.column > .back-btn.ldoc__back) {
      width: 100%;
    }
  }

  .ldoc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding: 28px;
  }
  .ldoc__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* As the game cards' titles (GameCard.astro). */
  .ldoc__title {
    font-weight: 700;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .ldoc__subject {
    color: var(--c-grey);
  }
  .ldoc__updated {
    font-family: var(--f-mono);
    font-size: 14px;
    color: var(--c-grey);
  }

  @media (max-width: 1279px) {
    .ldoc {
      gap: 24px;
      padding: 24px;
    }
    .ldoc__title {
      font-size: 27px;
    }
    .ldoc__updated {
      font-size: 13px;
    }
  }
  @media (max-width: 767px) {
    .ldoc {
      gap: 20px;
      padding: 4px 2px 8px;
    }
    .ldoc__title {
      font-size: 26px;
    }
  }
</style>
