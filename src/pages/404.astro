---
/**
 * 404: the usual shell with one container (unnumbered top tab, as wide as the container) saying the page doesn't exist, with a
 * button back to Start (← before the label). No entry in the top / mobile menu.
 */
import ContainerFrame from '../components/ContainerFrame.astro';
import BackButton from '../components/BackButton.astro';
import Shell from '../layouts/Shell.astro';
import { ROUTES } from '../lib/content';
---

<Shell page="not-found" label="Page not found" srHeading={false}>
  <ContainerFrame index={0} variant="start" fullTab active label="Page not found">
    <div class="nf">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1 class="nf__title">Page not found</h1>
      <p class="nf__text">This page doesn’t exist or has moved. Head back to the start to find your way around.</p>
      <BackButton href={ROUTES.start} label="BACK TO START" class="nf__btn" />
    </div>
  </ContainerFrame>
</Shell>

<style>
  /* Content as the game cards (GameCard.astro): title, grey description, button. */
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px;
  }
  .nf__code {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 120px;
    line-height: 0.9;
    color: var(--c-red);
  }
  .nf__title {
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .nf__text {
    max-width: 640px;
    font-weight: 500;
    font-size: 23px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .nf :global(.nf__btn) {
    margin-top: 10px;
  }

  @media (max-width: 1279px) {
    .nf {
      padding: 24px;
    }
    .nf__code {
      font-size: 100px;
    }
    .nf__title {
      font-size: 27px;
    }
    .nf__text {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    .nf {
      gap: 12px;
      padding: 4px 2px 8px;
    }
    .nf__code {
      font-size: 84px;
    }
    .nf__title {
      font-size: 26px;
    }
    .nf__text {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
  }
</style>
