---
import ContainerFrame from '../components/ContainerFrame.astro';
import GameCard from '../components/GameCard.astro';
import GameRow from '../components/GameRow.astro';
import Shell from '../layouts/Shell.astro';
import { getItems, newestFirst } from '../lib/content';

const items = (await getItems('games')).map(({ data }) => data);

// One row per category, rows in alphabetical order, games in a row newest first; a game in
// several categories shows in each of their rows. Each row numbers its games from 1.
const rows: { category: string; first: number; games: typeof items }[] = [];
for (const game of items) {
  for (const category of game.categories) {
    const row = rows.find((r) => r.category === category);
    if (row) row.games.push(game);
    else rows.push({ category, first: 0, games: [game] });
  }
}
rows.sort((a, b) => a.category.localeCompare(b.category, 'en', { numeric: true }));
rows.forEach((row) => row.games.sort(newestFirst));
rows.forEach((row, r) => (row.first = r ? rows[r - 1].first + rows[r - 1].games.length : 0));
---

<Shell page="games" rows>
  {
    rows.map((row, r) => (
      <GameRow title={row.category} titles={row.games.map((g) => g.title)} index={row.first} row={r} active={r === 0}>
        {row.games.map((game, i) => (
          <ContainerFrame
            index={row.first + i}
            variant="game"
            number={i + 1}
            active={r === 0 && i === 0}
            label={game.title}
          >
            <GameCard {...game} />
          </ContainerFrame>
        ))}
      </GameRow>
    ))
  }
</Shell>
