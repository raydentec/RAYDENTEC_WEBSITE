---
/**
 * Start (HANDOFF-2-START): two snap sections — the hero, then "What you can find here".
 * Start-only shell rules (no rail / mobile header / video on the hero) live in
 * scripts/start.ts.
 */
import Shell from '../layouts/Shell.astro';
import StartExplore from '../components/StartExplore.astro';
import StartHero from '../components/StartHero.astro';
import { getStart } from '../lib/content';

const { hero, explore } = await getStart();
---

<Shell page="start" srHeading={false} rows>
  <StartHero {...hero} />
  <StartExplore {...explore} />
</Shell>
