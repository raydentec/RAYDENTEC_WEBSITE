---
import ContainerFrame from '../components/ContainerFrame.astro';
import StartExplore from '../components/StartExplore.astro';
import StartIntro from '../components/StartIntro.astro';
import Shell from '../layouts/Shell.astro';
import { getItems } from '../lib/content';

// Start containers are unnumbered (HANDOFF §5).
const items = await getItems('start');
// Desktop / tablet container heights (mobile sizes to content). The intro holds the
// banner, title, subheadline, a 4–6 line paragraph and the buttons.
const HEIGHTS = { intro: 645, explore: 330 } as const;
const TABLET_HEIGHTS = { intro: 655, explore: 330 } as const;
---

<Shell page="start" srHeading={!items.some(({ data }) => data.type === 'intro')}>
  {
    items.map(({ data }, i) => (
      <ContainerFrame index={i} variant="start" active={i === 0} height={HEIGHTS[data.type]} tabletHeight={TABLET_HEIGHTS[data.type]} label={data.title}>
        {data.type === 'intro' ? <StartIntro {...data} /> : <StartExplore {...data} />}
      </ContainerFrame>
    ))
  }
</Shell>
