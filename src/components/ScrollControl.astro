---
/**
 * One control, three states (HANDOFF §7), driven by scripts/scroll-control.ts:
 *   data-state="top"     → SCROLL ↓ (snaps to the next container)
 *   data-state="scroll"  → BACK TO TOP ↑
 *   data-state="idle"    → 56×56 ↑ only, after 1.2s without scrolling
 * Mobile: full-width SCROLL at the top, the ↑ arrow otherwise.
 */
import Icon from './Icon.astro';
---

<button type="button" class="scroll-ctl ctl" data-scroll-ctl data-state="top" aria-label="Scroll to next item" transition:persist="scroll-ctl">
  <span class="scroll-ctl__label" aria-hidden="true">
    <span class="scroll-ctl__text scroll-ctl__text--top">SCROLL</span>
    <span class="scroll-ctl__text scroll-ctl__text--back">BACK TO TOP</span>
  </span>
  <span class="scroll-ctl__icon scroll-ctl__icon--down"><Icon name="arrowDown" size={30} /></span>
  <span class="scroll-ctl__icon scroll-ctl__icon--up"><Icon name="arrowUp" size={30} /></span>
</button>

<style>
  .scroll-ctl {
    position: fixed;
    right: var(--ctl-right);
    bottom: var(--ctl-bottom);
    width: var(--ctl-w);
    height: var(--ctl-h);
    display: flex;
    align-items: center;
    overflow: hidden;
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: var(--ctl-font);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    z-index: 6;
    transition: width var(--t-ctl) var(--ease-out);
  }
  .scroll-ctl__label {
    position: absolute;
    left: 28px;
    top: 50%;
    transform: translateY(-50%);
    transition: opacity var(--t-ctl) ease;
  }
  .scroll-ctl__text--back,
  [data-state='scroll'] .scroll-ctl__text--top,
  [data-state='idle'] .scroll-ctl__text--top {
    display: none;
  }
  [data-state='scroll'] .scroll-ctl__text--back,
  [data-state='idle'] .scroll-ctl__text--back {
    display: inline;
  }
  .scroll-ctl__icon {
    position: absolute;
    top: 50%;
    /* Anchored to the right edge, so it stays put while the width animates. */
    right: 23px;
    transform: translateY(-50%);
    transition: right var(--t-ctl) var(--ease-out);
  }
  [data-state='idle'] .scroll-ctl__icon {
    right: calc((var(--ctl-h) - 4px - 30px) / 2);
  }
  .scroll-ctl__icon--up,
  [data-state='scroll'] .scroll-ctl__icon--down,
  [data-state='idle'] .scroll-ctl__icon--down {
    display: none;
  }
  [data-state='scroll'] .scroll-ctl__icon--up,
  [data-state='idle'] .scroll-ctl__icon--up {
    display: block;
  }
  [data-state='idle'] {
    width: var(--ctl-h);
  }
  [data-state='idle'] .scroll-ctl__label {
    opacity: 0;
  }

  @media (max-width: 1279px) {
    .scroll-ctl__label {
      left: 27px;
    }
    .scroll-ctl__icon {
      right: 22px;
    }
  }
  @media (max-width: 767px) {
    .scroll-ctl {
      width: calc(100vw - 2 * var(--gutter));
      z-index: 6;
    }
    /* No BACK TO TOP label on mobile: arrow-only as soon as the page scrolls. */
    [data-state='scroll'],
    [data-state='idle'] {
      width: var(--ctl-h);
    }
    [data-state='scroll'] .scroll-ctl__label,
    [data-state='idle'] .scroll-ctl__label {
      opacity: 0;
    }
    [data-state='scroll'] .scroll-ctl__icon,
    [data-state='idle'] .scroll-ctl__icon {
      right: calc((var(--ctl-h) - 4px - 30px) / 2);
    }
  }
</style>
