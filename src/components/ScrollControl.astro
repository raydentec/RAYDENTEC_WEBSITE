---
/**
 * One control (HANDOFF §7), driven by scripts/scroll-control.ts.
 * What it does — data-mode:
 *   "down" → SCROLL ↓, snaps to the next container (until the last one is selected)
 *   "up"   → BACK TO TOP ↑, scrolls to the very top (once the last container is selected)
 * How big it is — data-state:
 *   "top" (scrollTop 0) / "scroll" (hovered or focused) → full width with label
 *   "idle" (scrolled; 2s after hover)                  → arrow-only square
 * Mobile: full width at the top and on the last container, arrow-only otherwise.
 * Disabled and hidden while the page can't scroll at all.
 */
import Icon from './Icon.astro';
---

<button type="button" class="scroll-ctl ctl" data-scroll-ctl data-state="top" data-mode="down" aria-label="Scroll to next item" transition:persist="scroll-ctl">
  <span class="scroll-ctl__label" aria-hidden="true">
    <span class="scroll-ctl__text scroll-ctl__text--top">SCROLL</span>
    <span class="scroll-ctl__text scroll-ctl__text--back">BACK TO TOP</span>
  </span>
  <span class="scroll-ctl__icon scroll-ctl__icon--down"><Icon name="arrowDown" size={30} /></span>
  <span class="scroll-ctl__icon scroll-ctl__icon--up"><Icon name="arrowUp" size={30} /></span>
</button>

<style>
  .scroll-ctl {
    position: fixed;
    right: var(--ctl-right);
    bottom: var(--ctl-bottom);
    width: var(--ctl-w);
    height: var(--ctl-h);
    display: flex;
    align-items: center;
    overflow: hidden;
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: var(--ctl-font);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    z-index: 6;
    transition: width var(--t-ctl) var(--ease-out);
  }
  .scroll-ctl__label {
    position: absolute;
    left: 28px;
    top: 50%;
    transform: translateY(-50%);
    transition: opacity var(--t-ctl) ease;
  }
  /* Label and arrow follow the mode. */
  .scroll-ctl__text--back,
  [data-mode='up'] .scroll-ctl__text--top {
    display: none;
  }
  [data-mode='up'] .scroll-ctl__text--back {
    display: inline;
  }
  .scroll-ctl__icon {
    position: absolute;
    top: 50%;
    /* Anchored to the right edge, so it stays put while the width animates. */
    right: 23px;
    transform: translateY(-50%);
    transition: right var(--t-ctl) var(--ease-out);
  }
  [data-state='idle'] .scroll-ctl__icon {
    right: calc((var(--ctl-h) - 4px - 30px) / 2);
  }
  .scroll-ctl__icon--up,
  [data-mode='up'] .scroll-ctl__icon--down {
    display: none;
  }
  [data-mode='up'] .scroll-ctl__icon--up {
    display: block;
  }
  [data-state='idle'] {
    width: var(--ctl-h);
  }
  /* Collapsing hides the label at once; expanding fades it back in. */
  [data-state='idle'] .scroll-ctl__label {
    opacity: 0;
    transition: none;
  }

  /* Nothing to scroll (scripts/scroll-control.ts): hidden; it comes back as soon as the
     page can scroll. */
  .scroll-ctl:disabled {
    visibility: hidden;
  }

  @media (max-width: 1279px) {
    .scroll-ctl__label {
      left: 27px;
    }
    .scroll-ctl__icon {
      right: 22px;
    }
  }
  /* Window being resized (scripts/scroll-control.ts): follow its size at once, so the
     full-width control stays lined up with the mobile menu bar. */
  .scroll-ctl[data-resizing] {
    transition: none;
  }
  @media (max-width: 767px) {
    .scroll-ctl {
      width: calc(100vw - 2 * var(--gutter));
      z-index: 6;
    }
    /* Mobile: arrow-only (↓ or ↑ by mode) as soon as the page scrolls — except the
       full-width BACK TO TOP kept open on the last container. */
    [data-state='scroll']:not([data-mode='up']),
    [data-state='idle'] {
      width: var(--ctl-h);
    }
    [data-state='scroll']:not([data-mode='up']) .scroll-ctl__label,
    [data-state='idle'] .scroll-ctl__label {
      opacity: 0;
      transition: none;
    }
    [data-state='scroll']:not([data-mode='up']) .scroll-ctl__icon,
    [data-state='idle'] .scroll-ctl__icon {
      right: calc((var(--ctl-h) - 4px - 30px) / 2);
    }
  }
</style>
