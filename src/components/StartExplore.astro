---
/**
 * Start · "What you can find here": the page's second snap section (container 1). A
 * sideways row like the Games rows (GameRow.astro, scripts/game-rows.ts) — headline and
 * indicator lined up with the content column, cards running edge to edge — holding the
 * numbered explore cards, sized as the games are (GameRow: ⅔ of the column, 85% on
 * mobile; height from the content). It stays lit while it peeks in under the hero.
 */
import ContainerFrame from './ContainerFrame.astro';
import GameRow from './GameRow.astro';
import StartCard from './StartCard.astro';

interface Props {
  title: string;
  items: {
    number: number;
    icon: string;
    title: string;
    description: string;
    image: string;
    href: string;
    linkLabel: string;
  }[];
}

const { title, items } = Astro.props;
---

<GameRow title={title} titles={items.map((i) => i.title)} index={0} row={0} itemsLabel="Sections" lit class="sx">
  {
    items.map((item, i) => (
      <ContainerFrame index={i} variant="start" number={item.number} active={i === 0} label={item.title}>
        <StartCard {...item} />
      </ContainerFrame>
    ))
  }
</GameRow>

<style>
  /* Paints over the hero image's masked-out lower part. */
  :global(.sx) {
    position: relative;
    z-index: 1;
  }
  /* All cards as tall as the tallest one; their bodies fill that height (StartCard pins its
     button to the bottom). */
  :global(.sx .grow__list) {
    align-items: stretch;
  }
  :global(.sx .grow__list > .cf) {
    display: flex;
    flex-direction: column;
  }
  :global(.sx .grow__list > .cf > .cf__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
  }
  :global(.sx .grow__list > .cf .cf__content) {
    flex: 1 0 auto;
    height: auto;
  }
</style>
