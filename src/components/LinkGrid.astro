---
/**
 * Community · "More links" container body: grid of flat link tiles — brand icon, then
 * the label (as on raydentec.com's "more links").
 */
import Icon from './Icon.astro';
import { linkAttrs } from '../lib/content';

interface Props {
  eyebrow: string;
  title: string;
  links: { icon?: string; label: string; href: string }[];
}

const { eyebrow, title, links } = Astro.props;
---

<div class="lg">
  <div class="lg__head">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="lg__title">{title}</h2>
  </div>
  <ul class="lg__grid">
    {
      links.map((l) => (
        <li>
          <a class="lg__link" {...linkAttrs(l.href)}>
            {l.icon && <Icon name={l.icon} size={20} />}
            <span class="lg__label">{l.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lg {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    height: 100%;
    padding: 28px 36px 28px 28px;
  }
  .lg__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lg__title {
    font-weight: 600;
    font-size: 28px;
    line-height: 1.05;
  }
  .lg__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Flat tile: #1E1E1E; on hover #2C2C2C with a white border (transparent at rest, so
     nothing shifts). Icon then uppercase label. */
  .lg__link {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 52px;
    padding: 0 18px;
    border: 2px solid transparent;
    background: var(--c-link-tile);
    font-family: var(--f-ui);
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-white);
    transition:
      background-color var(--t-fade),
      border-color var(--t-fade);
  }
  .lg__link:hover,
  .lg__link:focus-visible {
    background: var(--c-link-tile-hover);
    border-color: var(--c-white);
  }
  .lg__link :global(svg) {
    flex-shrink: 0;
  }
  .lg__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1279px) {
    .lg {
      padding: 24px 26px 24px 24px;
    }
    .lg__title {
      font-size: 25px;
    }
    .lg__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .lg__link {
      height: 46px;
      gap: 14px;
      padding: 0 16px;
      font-size: 15px;
    }
  }

  @media (max-width: 767px) {
    .lg {
      padding: 0;
      gap: 16px;
    }
    .lg__title {
      font-size: 22px;
    }
    .lg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .lg__link {
      height: 48px;
      gap: 10px;
      padding: 0 14px;
      font-size: 13px;
      letter-spacing: 0.06em;
    }
  }
</style>
