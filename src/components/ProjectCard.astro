---
/**
 * Projects container body: image left; right of it the title and description at the top
 * and, at the bottom, the button with a two-line "Tech used:" / stack caption to its
 * right (as on the Games cards). The text column is as tall as the image.
 */
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  title: string;
  description: string;
  stack: string;
  href: string;
  buttonLabel: string;
  image: string;
}

const { title, description, stack, href, buttonLabel, image } = Astro.props;
---

<div class="card">
  <img class="card__media" src={asset(image)} alt="" width="426" height="239" loading="lazy" decoding="async" />
  <div class="card__text">
    <h2 class="card__title">{title}</h2>
    <p class="card__desc">{description}</p>
    <div class="card__actions">
      <LinkButton href={href} label={buttonLabel} class="card__btn" />
      <p class="card__caption">
        <span>Tech used:</span>
        <span class="card__stack">{stack}</span>
      </p>
    </div>
  </div>
</div>

<style>
  /* One row, centred in the container: the image sets its height and the text column
     stretches to match. */
  .card {
    display: grid;
    grid-template-columns: min(426px, 48%) minmax(0, 1fr);
    align-content: center;
    align-items: stretch;
    column-gap: 40px;
    height: 100%;
    padding: 0 36px 0 28px;
  }
  .card__media {
    align-self: center;
    width: 100%;
    aspect-ratio: 426 / 239;
    height: auto;
    object-fit: cover;
  }
  .card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }
  .card__title {
    font-weight: 600;
    font-size: 30px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 24px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  /* Bottom of the column: button, caption to its right (below it when there's no room). */
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    width: 100%;
    margin-top: auto;
  }
  .card__caption {
    display: flex;
    flex: 1 1 120px;
    flex-direction: column;
    min-width: 0;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-grey);
  }
  .card__stack {
    color: var(--c-white);
  }
  .card :global(.card__btn) {
    flex-shrink: 0;
    width: 240px;
  }

  @media (max-width: 1279px) {
    .card {
      grid-template-columns: min(230px, 36%) minmax(0, 1fr);
      column-gap: 28px;
      padding: 0 26px 0 24px;
    }
    .card__media {
      aspect-ratio: 1;
    }
    .card__text {
      gap: 10px;
    }
    .card__title {
      font-size: 26px;
    }
    .card__desc {
      font-size: 21px;
    }
    .card__caption {
      font-size: 13px;
    }
    .card :global(.card__btn) {
      width: 230px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
  }

  @media (max-width: 767px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      row-gap: 14px;
      padding: 0;
    }
    /* Full width at 16:9, like the Games art. */
    .card__media {
      aspect-ratio: 16 / 9;
    }
    .card__text {
      align-items: stretch;
      gap: 12px;
    }
    .card__title {
      font-size: 24px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    /* Stacked: full-width button, caption on one line under it. */
    .card__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .card__caption {
      flex: none;
      flex-direction: row;
      justify-content: center;
      gap: 0.6em;
      text-align: center;
    }
    /* Full width, ↗ right after the label (the right end stays clear for the ↑ square). */
    .card :global(.card__btn) {
      width: 100%;
      justify-content: flex-start;
      gap: 14px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
  }
</style>
