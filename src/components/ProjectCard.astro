---
/** Projects container body: image left, text right (as on the Games cards), Stack / Year list. */
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  stack: string;
  year: string;
  href: string;
  buttonLabel: string;
  image: string;
}

const { eyebrow, title, description, stack, year, href, buttonLabel, image } = Astro.props;
---

<div class="card">
  <img class="card__media" src={asset(image)} alt="" width="426" height="239" loading="lazy" decoding="async" />
  <div class="card__text">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="card__title">{title}</h2>
    <p class="card__desc">{description}</p>
    <dl class="card__meta">
      <div>
        <dt>Stack</dt>
        <dd>{stack}</dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd>{year}</dd>
      </div>
    </dl>
    <LinkButton href={href} label={buttonLabel} class="card__btn" />
  </div>
</div>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 100%;
    padding: 0 36px 0 28px;
  }
  .card__media {
    width: min(426px, 48%);
    aspect-ratio: 426 / 239;
    height: auto;
    object-fit: cover;
    flex-shrink: 0;
  }
  .card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    flex-grow: 1;
    min-width: 0;
  }
  .card__title {
    font-weight: 600;
    font-size: 30px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 24px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    width: 100%;
    font-family: var(--f-mono);
    font-size: 13px;
  }
  .card__meta div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .card__meta dt {
    color: var(--c-grey);
  }
  .card__meta dd {
    color: var(--c-white);
  }
  .card :global(.card__btn) {
    width: 270px;
  }

  @media (max-width: 1279px) {
    .card {
      gap: 28px;
      padding: 0 26px 0 24px;
    }
    .card__media {
      width: min(230px, 36%);
      aspect-ratio: 1;
    }
    .card__text {
      gap: 10px;
    }
    .card__title {
      font-size: 26px;
    }
    .card__desc {
      font-size: 21px;
    }
    .card :global(.card__btn) {
      width: 250px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
  }

  @media (max-width: 767px) {
    .card {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 0;
    }
    .card__media {
      width: 100%;
      height: 230px;
      aspect-ratio: auto;
    }
    .card__text {
      align-items: stretch;
      gap: 12px;
    }
    .card__title {
      font-size: 24px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    /* Full width, ↗ right after the label (the right end stays clear for the ↑ square). */
    .card :global(.card__btn) {
      width: 100%;
      justify-content: flex-start;
      gap: 14px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
  }
</style>
