---
/** Start · Intro container body: banner across the top, then title, text and two CTAs. */
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  media: string;
  mediaNote?: string;
  actions: { label: string; href: string; variant: 'primary' | 'secondary' }[];
}

const { eyebrow, title, description, media, mediaNote, actions } = Astro.props;
---

<div class="intro">
  <div class="intro__banner">
    <img src={asset(media)} alt="" width="924" height="220" decoding="async" />
    {mediaNote && <span class="intro__note">[ {mediaNote} ]</span>}
  </div>
  <div class="intro__text">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="intro__title">{title}</h1>
    <p class="intro__desc">{description}</p>
    <div class="intro__actions">
      {
        actions.map((a) => (
          <LinkButton
            href={a.href}
            label={a.label}
            variant={a.variant === 'primary' ? 'primary' : 'outline'}
            class="intro__btn"
          />
        ))
      }
    </div>
  </div>
</div>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 22px;
    height: 100%;
    padding: 29px 36px 29px 28px;
  }
  .intro__banner {
    position: relative;
    height: 220px;
    flex-shrink: 0;
  }
  .intro__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .intro__note {
    position: absolute;
    left: 14px;
    bottom: 12px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.6);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--c-white);
  }
  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .intro__title {
    font-weight: 700;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .intro__desc {
    max-width: 760px;
    font-weight: 500;
    font-size: 26px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .intro :global(.intro__btn) {
    width: 240px;
    --btn-font: 18px;
  }

  @media (max-width: 1279px) {
    .intro {
      padding: 24px 26px 24px 24px;
    }
    .intro__title {
      font-size: 40px;
    }
    .intro__desc {
      font-size: 23px;
    }
    .intro :global(.intro__btn) {
      width: 230px;
      --btn-h: 52px;
    }
  }

  @media (max-width: 767px) {
    .intro {
      padding: 0;
      gap: 14px;
    }
    .intro__banner {
      height: 200px;
    }
    .intro__text {
      gap: 12px;
    }
    .intro__title {
      font-size: 32px;
    }
    .intro__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    .intro__actions {
      flex-direction: column;
      gap: 8px;
      margin-top: 4px;
    }
    .intro :global(.intro__btn) {
      width: 100%;
      --btn-font: 18px;
      padding: 0 18px 0 24px;
    }
  }
</style>
