---
/**
 * Projects category filter panel (pages/projects.astro, in Shell's overlay slot), opened
 * by the FILTER button (FilterButton.astro). A dark grey box as wide as the column —
 * at the bottom, centred horizontally on desktop / tablet, over SCROLL and FILTER on
 * mobile: a "Filter"
 * headline with Clear on the right, and along the bottom the category buttons in a row
 * that scrolls sideways across the whole panel width (scripts/project-filter.ts filters
 * the list as they're toggled). FILTER, Escape or a click outside close it.
 *
 * Closed it's hidden (and out of the tab order); open, it fades / slides in.
 */
import { projectCategories } from '../lib/project-categories';
---

<div class="fpanel" id="project-filter" data-filter-panel>
  <div class="fpanel__head">
    <h2 class="fpanel__label" id="projects-categories">Filter</h2>
    <button type="button" class="pfilter__btn fpanel__clear" data-filter-clear disabled>Clear</button>
  </div>
  <div class="pfilter" role="group" aria-labelledby="projects-categories" data-filter>
    {
      projectCategories.map((label) => (
        <button type="button" class="pfilter__btn" data-filter-btn={label} aria-pressed="false">
          {label}
        </button>
      ))
    }
  </div>
</div>

<style>
  /*
   * As wide as the column (as Shell.astro), at the bottom: from SCROLL's bottom edge up,
   * rising into place. Desktop / tablet: centred horizontally on the screen (below).
   */
  .fpanel {
    --box-pad: 20px;
    --title-size: 30px;
    --filter-h: 44px;
    position: fixed;
    display: flex;
    flex-direction: column;
    bottom: var(--ctl-bottom);
    /* About three button heights plus the padding, at every size. */
    height: calc(3 * var(--ctl-h) + 2 * var(--box-pad));
    left: calc((100vw - var(--content-w)) / 2);
    width: var(--content-w);
    /* Above the content and SCROLL (same level, later in the page), below the menu. */
    z-index: 6;
    padding: var(--box-pad);
    /* Dark grey (as the Community "More links" tiles) under a gradient from transparent
       at the top to black at the bottom, with a red line along the top edge (as thick as
       the red bar at the top of the window). */
    border-top: var(--top-bar) solid var(--c-red);
    background: linear-gradient(to top, var(--c-black), rgba(0, 0, 0, 0)), var(--c-link-tile);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-fade) ease,
      visibility 0s linear var(--t-fade),
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  .fpanel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-fade) ease,
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  /* Desktop / tablet: centred horizontally on the screen (still at the bottom, as wide as
     the column); rises into place. */
  @media (min-width: 768px) {
    .fpanel {
      left: 50%;
      transform: translate(-50%, 8px);
    }
    .fpanel[data-open] {
      transform: translateX(-50%);
    }
  }
  @media (min-width: 1280px) {
    :global(html[data-sidebar='expanded']) .fpanel {
      width: var(--content-w-expanded);
    }
  }

  /* Top (inside the padding): headline (as the category headlines on the page), Clear on
     the right; the category buttons sit at the bottom. */
  .fpanel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .fpanel__label {
    font-weight: 700;
    font-size: var(--title-size);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* Clear: the category buttons' shape in white — 50% white border (as theirs) and white
     label; hovered, the border gives way to a 25% white fill; dimmed (and inert) while
     nothing is selected.
     (Head-qualified to win over .pfilter__btn below.) */
  .fpanel__head .fpanel__clear {
    height: var(--filter-h);
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
    color: var(--c-white);
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease,
      opacity var(--t-fade);
  }
  .fpanel__head .fpanel__clear:hover {
    border-color: rgba(255, 255, 255, 0);
    background: rgba(255, 255, 255, 0.25);
    color: var(--c-white);
  }
  .fpanel__head .fpanel__clear:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .fpanel__head .fpanel__clear:disabled:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
  }

  /* Bottom: one row of buttons scrolling sideways within the panel's padding; buttons are
     cut off (masked) at the padding on either side (no scrollbar). */
  .pfilter {
    display: flex;
    gap: 10px;
    height: var(--filter-h);
    margin-top: auto;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .pfilter::-webkit-scrollbar {
    display: none;
  }
  /* Inactive: white label, 50% white border, no fill; hovered, a full white border and a
     25% white fill. Selected: solid white fill, black label. */
  .pfilter__btn {
    flex-shrink: 0;
    height: 100%;
    padding: 0 22px;
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
    color: var(--c-white);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 20px;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease;
  }
  .pfilter__btn:hover {
    border-color: var(--c-white);
    background: rgba(255, 255, 255, 0.25);
  }
  .pfilter__btn[aria-pressed='true'] {
    border-color: var(--c-white);
    background: var(--c-white);
    color: var(--c-black);
  }
  .pfilter__btn:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }

  @media (max-width: 1279px) {
    .fpanel {
      --box-pad: 16px;
      --title-size: 26px;
      --filter-h: 42px;
    }
    .pfilter__btn {
      padding: 0 18px;
      font-size: 18px;
    }
  }
  /* Mobile: smaller buttons, left-aligned at their own size. */
  @media (max-width: 767px) {
    .fpanel {
      --box-pad: 12px;
      --title-size: 24px;
    }
    .pfilter {
      gap: 8px;
    }
    .pfilter__btn {
      padding: 0 14px;
      font-size: 16px;
    }
  }
</style>
