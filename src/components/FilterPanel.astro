---
/**
 * Projects category filter panel (pages/projects.astro, in Shell's overlay slot), opened
 * by the FILTER button (FilterButton.astro). A black box at the bottom of the content,
 * covering SCROLL and FILTER above it, as wide as the column: a "Filter"
 * headline with a close (×) button on the right, and along the bottom the category
 * buttons (scrolling sideways if needed) with Clear fixed on the right
 * (scripts/project-filter.ts filters the list as they're toggled).
 *
 * Closed it's hidden (and out of the tab order); open, it fades / slides in.
 */
import Icon from './Icon.astro';
import { projectCategories } from '../lib/project-categories';
---

<div class="fpanel" id="project-filter" data-filter-panel>
  <div class="fpanel__head">
    <h2 class="fpanel__label" id="projects-categories">Filter</h2>
    <button type="button" class="fpanel__close" aria-label="Close filter" data-filter-close>
      <Icon name="close" size={26} />
    </button>
  </div>
  <div class="fpanel__row">
    <div class="pfilter" role="group" aria-labelledby="projects-categories" data-filter>
      {
        projectCategories.map((label) => (
          <button type="button" class="pfilter__btn" data-filter-btn={label} aria-pressed="false">
            {label}
          </button>
        ))
      }
    </div>
    <button type="button" class="pfilter__btn fpanel__clear" data-filter-clear disabled>Clear</button>
  </div>
</div>

<style>
  /*
   * At the bottom, the column's left edge and width (as Shell.astro): from SCROLL's bottom
   * edge up to FILTER's top edge — exactly the two buttons' height — rising into place.
   */
  .fpanel {
    --box-pad: 20px;
    --title-size: 30px;
    --filter-h: 44px;
    position: fixed;
    display: flex;
    flex-direction: column;
    bottom: var(--ctl-bottom);
    height: calc(2 * var(--ctl-h) + 12px);
    left: calc((100vw - var(--content-w)) / 2);
    width: var(--content-w);
    /* Above the content and SCROLL (same level, later in the page), below the menu. */
    z-index: 6;
    padding: var(--box-pad);
    background: var(--c-black);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-fade) ease,
      visibility 0s linear var(--t-fade),
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  .fpanel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-fade) ease,
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  @media (min-width: 1280px) {
    :global(html[data-sidebar='expanded']) .fpanel {
      left: var(--col-left-expanded);
      width: var(--content-w-expanded);
    }
  }

  /*
   * Top: headline (as the category headlines on the page), × on the right. The row sits
   * flush with the panel's top edge and × in its top-right corner, as tall as FILTER and
   * level with it (where the column reaches the button, the same square).
   */
  .fpanel__head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: calc(-1 * var(--box-pad)) calc(-1 * var(--box-pad)) 0 0;
  }
  .fpanel__label {
    flex: 1 1 auto;
    font-weight: 700;
    font-size: var(--title-size);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* White × centred in a borderless square as tall as EXPAND / SCROLL; red on hover. */
  .fpanel__close {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--ctl-h);
    height: var(--ctl-h);
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-white);
    cursor: pointer;
    transition: color var(--t-state) ease;
  }
  .fpanel__close:hover {
    color: var(--c-red);
  }
  .fpanel__close:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }

  /* Bottom: the category buttons, then Clear on the right (same size and style), kept
     clear of the scrolling buttons by a gap. Clear is dimmed (and inert) while nothing is
     selected. */
  .fpanel__row {
    display: flex;
    gap: 16px;
    height: var(--filter-h);
    margin-top: auto;
  }
  /* Clear: the category buttons' shape in white — white border and label; hovered, the
     border gives way to a 25% white fill. (Row-qualified to win over .pfilter__btn below.) */
  .fpanel__row .fpanel__clear {
    border-color: var(--c-white);
    background: rgba(255, 255, 255, 0);
    color: var(--c-white);
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease,
      opacity var(--t-fade);
  }
  .fpanel__row .fpanel__clear:hover {
    border-color: rgba(255, 255, 255, 0);
    background: rgba(255, 255, 255, 0.25);
    color: var(--c-white);
  }
  .fpanel__row .fpanel__clear:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .fpanel__row .fpanel__clear:disabled:hover {
    border-color: var(--c-white);
    background: rgba(255, 255, 255, 0);
  }

  /* One row of buttons; scrolls sideways when it doesn't fit (no scrollbar). */
  .pfilter {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    gap: 10px;
    height: var(--filter-h);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .pfilter::-webkit-scrollbar {
    display: none;
  }
  /* Inactive: red border and label, no fill; hovered, the border gives way to a 25% red
     fill. Selected: solid red fill, black label. */
  .pfilter__btn {
    flex-shrink: 0;
    height: 100%;
    padding: 0 22px;
    border: 1.5px solid var(--c-red);
    background: rgba(204, 24, 30, 0);
    color: var(--c-red);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 20px;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease;
  }
  .pfilter__btn:hover {
    border-color: rgba(204, 24, 30, 0);
    background: rgba(204, 24, 30, 0.25);
  }
  .pfilter__btn[aria-pressed='true'] {
    border-color: var(--c-red);
    background: var(--c-red);
    color: var(--c-black);
  }
  .pfilter__btn:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }

  @media (max-width: 1279px) {
    .fpanel {
      --box-pad: 16px;
      --title-size: 26px;
      --filter-h: 42px;
    }
    .pfilter__btn {
      padding: 0 18px;
      font-size: 18px;
    }
  }
  /* Mobile: smaller buttons, left-aligned at their own size. */
  @media (max-width: 767px) {
    .fpanel {
      --box-pad: 12px;
      --title-size: 24px;
    }
    .pfilter {
      gap: 8px;
    }
    .fpanel__row {
      gap: 12px;
    }
    .pfilter__btn {
      padding: 0 14px;
      font-size: 16px;
    }
  }
</style>
