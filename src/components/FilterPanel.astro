---
/**
 * Projects category filter panel (pages/projects.astro, in Shell's overlay slot), opened
 * by the FILTER button (FilterButton.astro). A dark grey box as wide as the column —
 * at the bottom, centred horizontally on desktop / tablet, over SCROLL and FILTER on
 * mobile: a "Filter"
 * headline with Clear on the right, and along the bottom the category buttons in a row
 * that scrolls sideways across the whole panel width (scripts/project-filter.ts filters
 * the list as they're toggled). FILTER, Escape or a click outside close it.
 *
 * Closed it's hidden (and out of the tab order); open, it fades / slides in. Sideways
 * scrolling anywhere on the panel — trackpad / shift+wheel, or a touch swipe — moves the
 * button row.
 */
import { projectCategories } from '../lib/project-categories';
---

<div class="fpanel" id="project-filter" data-filter-panel>
  <div class="fpanel__head">
    <h2 class="fpanel__label" id="projects-categories">Filter</h2>
    <button type="button" class="pfilter__btn fpanel__clear" data-filter-clear disabled>Clear</button>
  </div>
  <div class="pfilter" role="group" aria-labelledby="projects-categories" data-filter>
    {
      projectCategories.map((label) => (
        <button type="button" class="pfilter__btn" data-filter-btn={label} aria-pressed="false">
          {label}
        </button>
      ))
    }
  </div>
</div>

<script>
  // Sideways scroll gestures anywhere on the panel scroll the category row (the row itself
  // scrolls natively).
  const rowOf = (el: Element | null) =>
    el?.closest('[data-filter-panel]')?.querySelector<HTMLElement>('[data-filter]') ?? null;
  const onRow = (el: Element | null) => !!el?.closest('[data-filter]');

  // Trackpad sideways swipe, or shift + wheel.
  document.addEventListener(
    'wheel',
    (e) => {
      const target = e.target as Element | null;
      const row = rowOf(target);
      if (!row || onRow(target) || e.ctrlKey) return;
      const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.shiftKey ? e.deltaY : 0;
      if (!dx) return;
      e.preventDefault();
      e.stopPropagation(); // not forwarded to the page (scripts/wheel.ts)
      row.scrollLeft += e.deltaMode === WheelEvent.DOM_DELTA_LINE ? dx * 16 : dx;
    },
    { passive: false, capture: true },
  );

  // Touch: drag sideways anywhere on the panel (vertical drags are left alone).
  let drag: { row: HTMLElement; id: number; x: number; y: number; on: boolean } | null = null;
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Element | null;
    const row = rowOf(target);
    if (e.pointerType !== 'touch' || !row || onRow(target)) return;
    drag = { row, id: e.pointerId, x: e.clientX, y: e.clientY, on: false };
  });
  document.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.x;
    if (!drag.on) {
      if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(e.clientY - drag.y)) return;
      drag.on = true;
    }
    drag.row.scrollLeft -= dx;
    drag.x = e.clientX;
  });
  const endDrag = (e: PointerEvent) => {
    if (drag && e.pointerId === drag.id) drag = null;
  };
  document.addEventListener('pointerup', endDrag);
  document.addEventListener('pointercancel', endDrag);
</script>

<style>
  /*
   * As wide as the column (as Shell.astro), at the bottom: from SCROLL's bottom edge up,
   * rising into place. Desktop / tablet: centred horizontally on the screen (below).
   */
  .fpanel {
    --box-pad: 20px;
    --title-size: 30px;
    /* Buttons as tall as FILTER / SCROLL. */
    --filter-h: var(--ctl-h);
    position: fixed;
    display: flex;
    flex-direction: column;
    /* Horizontal touch drags are handled by the script (sideways scroll of the row). */
    touch-action: pan-y;
    bottom: var(--ctl-bottom);
    /* About three button heights plus the padding, at every size. */
    height: calc(3 * var(--ctl-h) + 2 * var(--box-pad));
    left: calc((100vw - var(--content-w)) / 2);
    width: var(--content-w);
    /* Above the content and SCROLL (same level, later in the page), below the menu. */
    z-index: 6;
    padding: var(--box-pad);
    /* Dark grey, as the Community "More links" tiles, with a red line along the top edge
       (as thick as the red bar at the top of the window). */
    border-top: var(--top-bar) solid var(--c-red);
    background: var(--c-link-tile);
    /* Opening, it flies up into place from --rise below (eased out); closing just fades. */
    --rise: 32px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(var(--rise));
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-fade) ease,
      visibility 0s linear var(--t-fade),
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  .fpanel[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--t-fade) ease,
      transform var(--t-sidebar) var(--ease-out),
      left var(--t-sidebar) var(--ease-out),
      width var(--t-sidebar) var(--ease-out);
  }
  /* Desktop / tablet: centred horizontally on the screen (still at the bottom, as wide as
     the column); rises into place. */
  @media (min-width: 768px) {
    .fpanel {
      left: 50%;
      transform: translate(-50%, var(--rise));
    }
    .fpanel[data-open] {
      transform: translateX(-50%);
    }
  }
  @media (min-width: 1280px) {
    :global(html[data-sidebar='expanded']) .fpanel {
      width: var(--content-w-expanded);
    }
  }

  /* Top (inside the padding): headline (as the category headlines on the page), Clear on
     the right; the category buttons sit at the bottom. */
  .fpanel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .fpanel__label {
    font-weight: 700;
    font-size: var(--title-size);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* Clear: the category buttons' shape in white — 50% white border (as theirs) and white
     label; hovered, the border gives way to a 25% white fill; dimmed (and inert) while
     nothing is selected.
     (Head-qualified to win over .pfilter__btn below.) */
  .fpanel__head .fpanel__clear {
    height: var(--filter-h);
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
    color: var(--c-white);
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease,
      opacity var(--t-fade);
  }
  .fpanel__head .fpanel__clear:hover {
    border-color: rgba(255, 255, 255, 0);
    background: rgba(255, 255, 255, 0.25);
    color: var(--c-white);
  }
  .fpanel__head .fpanel__clear:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .fpanel__head .fpanel__clear:disabled:hover {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
  }

  /* Bottom: one row of buttons scrolling sideways within the panel's padding; buttons are
     cut off (masked) at the padding on either side (no scrollbar). */
  .pfilter {
    display: flex;
    gap: 10px;
    height: var(--filter-h);
    margin-top: auto;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .pfilter::-webkit-scrollbar {
    display: none;
  }
  /* Inactive: white label, 50% white border, no fill; hovered, a full white border and a
     25% white fill. Selected: solid white fill, black label. */
  .pfilter__btn {
    flex-shrink: 0;
    height: 100%;
    /* Space left and right of the label 1.5× the space above and below its capitals
       (Chakra Petch caps are 0.7em tall), inside the 1.5px border. */
    padding: 0 calc(1.5 * (var(--filter-h) - 3px - 0.7em) / 2);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0);
    color: var(--c-white);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      color var(--t-state) ease;
  }
  .pfilter__btn:hover {
    border-color: var(--c-white);
    background: rgba(255, 255, 255, 0.25);
  }
  .pfilter__btn[aria-pressed='true'] {
    border-color: var(--c-white);
    background: var(--c-white);
    color: var(--c-black);
  }
  .pfilter__btn:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }

  @media (max-width: 1279px) {
    .fpanel {
      --box-pad: 16px;
      --title-size: 26px;
    }
    .pfilter__btn {
      font-size: 18px;
    }
  }
  /* Mobile: smaller buttons, left-aligned at their own size. */
  @media (max-width: 767px) {
    .fpanel {
      --box-pad: 12px;
      --title-size: 24px;
    }
    .pfilter {
      gap: 8px;
    }
    .pfilter__btn {
      font-size: 16px;
    }
  }
</style>
