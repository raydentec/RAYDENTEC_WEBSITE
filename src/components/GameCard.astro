---
/** Games container body: key art left, text right with platform/status chips (HANDOFF §5). */
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  platform: string;
  status: string;
  href: string;
  buttonLabel: string;
  caption?: string;
  image: string;
}

const { eyebrow, title, description, platform, status, href, buttonLabel, caption, image } = Astro.props;
---

<div class="card">
  <img class="card__media" src={asset(image)} alt="" width="426" height="239" loading="lazy" decoding="async" />
  <div class="card__text">
    <span class="eyebrow">{eyebrow}</span>
    <h2 class="card__title">{title}</h2>
    <p class="card__desc">{description}</p>
    <ul class="card__chips" aria-label="Details">
      <li class="card__chip">{platform}</li>
      <li class="card__chip card__chip--status">{status}</li>
    </ul>
    <div class="card__actions">
      <LinkButton href={href} label={buttonLabel} class="card__btn" />
      {caption && <span class="card__caption">{caption}</span>}
    </div>
  </div>
</div>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 100%;
    padding: 0 36px 0 28px;
  }
  .card__media {
    width: min(426px, 48%);
    aspect-ratio: 426 / 239;
    height: auto;
    object-fit: cover;
    flex-shrink: 0;
  }
  .card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    flex-grow: 1;
    min-width: 0;
  }
  .card__title {
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 23px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 12px;
  }
  .card__chip {
    padding: 5px 8px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .card__chip--status {
    border-color: var(--c-red);
    color: var(--c-red);
  }
  .card__actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .card :global(.card__btn) {
    width: 210px;
  }
  .card__caption {
    max-width: 130px;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-grey);
  }

  @media (max-width: 1279px) {
    .card {
      gap: 28px;
      padding: 0 26px 0 24px;
    }
    .card__media {
      width: min(230px, 36%);
      aspect-ratio: 1;
    }
    .card__text {
      gap: 10px;
    }
    .card__title {
      font-size: 28px;
    }
    .card__desc {
      font-size: 21px;
    }
    .card__actions {
      gap: 20px;
    }
    .card :global(.card__btn) {
      width: 200px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
    .card__caption {
      font-size: 13px;
    }
  }

  @media (max-width: 767px) {
    .card {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 0;
    }
    .card__media {
      width: 100%;
      height: 230px;
      aspect-ratio: auto;
    }
    .card__text {
      align-items: stretch;
      gap: 12px;
    }
    .card__title {
      font-size: 26px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    .card__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    .card :global(.card__btn) {
      width: 100%;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
    .card__caption {
      max-width: none;
      font-size: 13px;
      text-align: center;
    }
  }
</style>
