---
/**
 * Games container body: key art on top, then title / description, and under
 * them the VIEW GAME button with a two-line caption ("Available for" / platform) to its
 * right. The art is full width at 16:9; the card's height follows.
 */
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  title: string;
  description: string;
  platform: string;
  href: string;
  buttonLabel: string;
  caption?: string;
  image: string;
}

const { title, description, platform, href, buttonLabel, caption, image } = Astro.props;
---

<div class="card">
  <img class="card__media" src={asset(image)} alt="" width="1280" height="720" loading="lazy" decoding="async" />
  <div class="card__text">
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{description}</p>
  </div>
  <div class="card__actions">
    <LinkButton href={href} label={buttonLabel} class="card__btn" />
    <p class="card__caption">
      {caption && <span>{caption}</span>}
      <span class="card__platform">{platform}</span>
    </p>
  </div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    padding: 28px;
  }
  /* 16:9 art, full card width. */
  .card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: cover;
  }
  .card__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
  }
  .card__title {
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 23px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  /* Button on the left, caption to its right. */
  .card__actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .card__caption {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-grey);
  }
  .card__platform {
    color: var(--c-white);
  }
  .card :global(.card__btn) {
    flex-shrink: 0;
    width: 210px;
  }

  @media (max-width: 1279px) {
    .card {
      gap: 14px;
      padding: 22px;
    }
    .card__title {
      font-size: 27px;
    }
    .card__desc {
      font-size: 20px;
    }
    .card__caption {
      font-size: 13px;
    }
    .card :global(.card__btn) {
      width: 200px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
  }

  @media (max-width: 767px) {
    .card {
      gap: 14px;
      padding: 0;
    }
    .card__text {
      align-items: stretch;
      gap: 12px;
    }
    .card__title {
      font-size: 26px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    /* Stacked: full-width button, caption under it. */
    .card__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .card__caption {
      flex-direction: row;
      justify-content: center;
      gap: 0.6em;
      text-align: center;
    }
    /* Full width, ↗ right after the label (the right end stays clear for the ↑ square). */
    .card :global(.card__btn) {
      width: 100%;
      justify-content: flex-start;
      gap: 14px;
      --btn-h: 52px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
  }
</style>
