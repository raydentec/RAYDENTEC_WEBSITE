---
/**
 * Background video switch: a small square with a white line border and a lightning bolt.
 * Pressed, the lightning video fades out and a still blue glow fades in instead
 * (scripts/bg-video.ts, <html data-bg="glow">); the bolt is then struck through. Pressing
 * again brings the video back. Half opaque. Tablet and up: fixed at the top right of the
 * window (Shell.astro); mobile: top right of the profile (Profile.astro). Start: top right
 * of the hero on every screen (StartHero.astro).
 */
import Icon from './Icon.astro';

interface Props {
  class?: string;
  /** Icon size (px) as markup; CSS then stretches the bolt to fill the button. */
  size?: number;
}

const { class: className, size = 24 } = Astro.props;
---

<button
  type="button"
  class:list={['bg-toggle', className]}
  data-bg-toggle
  aria-pressed="true"
  aria-label="Background animation"
  title="Background animation on / off"
>
  <Icon name="bolt" size={size} />
  <span class="bg-toggle__strike" aria-hidden="true"></span>
</button>

<style>
  .bg-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    opacity: 0.5;
    border: 2px solid var(--c-white);
    background: rgba(0, 0, 0, 0.5);
    color: var(--c-white);
    transition:
      background-color var(--t-fade),
      color var(--t-fade);
  }
  /* The bolt fills the square inside the border, leaving only a thin margin; 30% narrower. */
  .bg-toggle :global(svg) {
    width: 100%;
    height: 100%;
    transform: scaleX(0.7);
  }
  .bg-toggle:hover,
  .bg-toggle:focus-visible {
    background: var(--c-white);
    color: var(--c-black);
  }
  /* Off: a line struck across the square, corner to corner (√2 × its side, clipped at the border). */
  .bg-toggle__strike {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 141.5%;
    height: 2px;
    background: currentColor;
    transform: translate(-50%, -50%) rotate(-45deg) scaleX(0);
    transition: transform var(--t-state) var(--ease-out);
  }
  :global(html[data-bg='glow']) .bg-toggle__strike {
    transform: translate(-50%, -50%) rotate(-45deg) scaleX(1);
  }
</style>
