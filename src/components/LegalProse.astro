---
/**
 * Long-form text of the Legal pages (Markdown rendered into the slot): readable grey body
 * text at a comfortable line length, white headings, red links, lists, and the wide
 * California categories table scrolling sideways on narrow screens.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    /* Never wider than the container (a wide table scrolls inside it instead). */
    width: 100%;
    min-width: 0;
    max-width: 760px;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--c-grey);
    overflow-wrap: anywhere;
  }
  .prose :global(> * + *) {
    margin-top: 1em;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(h2),
  .prose :global(h3) {
    margin-bottom: 0;
  }
  .prose :global(strong) {
    font-weight: 600;
    color: var(--c-white);
  }
  .prose :global(em) {
    font-style: italic;
  }

  /* Section headings (numbered in the documents): the site's UI face, uppercase as written. */
  .prose :global(h2) {
    margin-top: 2.4em;
    padding-top: 14px;
    border-top: 2px solid var(--c-red);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--c-white);
    /* Jumped to from the table of contents: a little below the snap line (under the nav /
       mobile header), pages/legal/[slug].astro. */
    scroll-margin-top: 24px;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--c-white);
  }

  .prose :global(a) {
    color: var(--c-red);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--t-fade);
  }
  .prose :global(a:hover) {
    color: var(--c-white);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li + li) {
    margin-top: 0.45em;
  }
  /* Nested list (e.g. purposes under a legal basis): indented, a little tighter. */
  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-top: 0.45em;
  }
  .prose :global(li::marker) {
    color: var(--c-red);
  }
  /* Table of contents: a two-column list of section links in the body text style (grey),
     numbered in white; a link lights up white on hover. */
  .prose :global(#toc + ol) {
    columns: 2;
    column-gap: 32px;
  }
  .prose :global(#toc + ol li) {
    break-inside: avoid;
  }
  .prose :global(#toc + ol li::marker) {
    color: var(--c-white);
  }
  .prose :global(#toc + ol a) {
    color: var(--c-grey);
    text-decoration: none;
  }
  .prose :global(#toc + ol a:hover),
  .prose :global(#toc + ol a:focus-visible) {
    color: var(--c-white);
  }

  /* Wide tables scroll sideways inside the text column. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.35;
  }
  .prose :global(th),
  .prose :global(td) {
    min-width: 120px;
    /* Whole words only (the text column breaks long words; cells scroll sideways instead). */
    overflow-wrap: normal;
    padding: 10px 12px;
    border: 1px solid #2c2c2c;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--c-white);
    font-weight: 600;
    background: var(--c-link-tile);
  }
  /* Categories table (privacy policies): the Yes / No column stays narrow, and a "Yes"
     reads white (collected) next to the grey "No". */
  .prose :global(th:last-child),
  .prose :global(td:last-child) {
    min-width: 0;
    white-space: nowrap;
    text-align: center;
  }
  .prose :global(td:first-child) {
    color: var(--c-white);
  }

  @media (max-width: 1279px) {
    .prose {
      font-size: 17px;
    }
    .prose :global(h2) {
      font-size: 20px;
    }
  }
  @media (max-width: 767px) {
    .prose {
      font-size: 16px;
    }
    .prose :global(h2) {
      font-size: 18px;
    }
    .prose :global(h3) {
      font-size: 18px;
    }
    .prose :global(#toc + ol) {
      columns: 1;
    }
    /* The table scrolls sideways: its text columns keep a readable width. */
    .prose :global(td:nth-child(2)) {
      min-width: 220px;
    }
    .prose :global(td:first-child) {
      min-width: 150px;
    }
  }
</style>
