---
/**
 * The shared container frame (HANDOFF §5): highlight on the LEFT, number at the TOP.
 *
 *   active   → 2px red body border, solid red column (num-col wide) down the left,
 *              black number.
 *   inactive → 1.5px dim-red body border, notch tab (num-col × notch-h) open to the
 *              right, number in 60% red, body content at 42% opacity.
 *
 * Desktop/tablet sizes come from tokens (--num-col, --notch-h, --card-h).
 * Mobile: the number moves into a 38px tab above the body (full-width red bar when
 * active, 86px notch when inactive).
 *
 * `number` is omitted for unnumbered containers (Community Shortcuts).
 * The active state is toggled at runtime by scripts/snap.ts (`.is-active`); for games in
 * sideways rows by scripts/game-rows.ts.
 */
interface Props {
  variant: 'community' | 'game' | 'project' | 'start';
  number?: number;
  active?: boolean;
  /** Desktop/tablet height override (Start explore cards). */
  height?: number;
  /** Tablet-only height override (defaults to `height`). */
  tabletHeight?: number;
  /**
   * No border/background on the body: its content draws its own framed sections
   * (Community pairs). The number tab / red column stay as usual.
   */
  bare?: boolean;
  /** Height from the content instead of a fixed size (desktop/tablet; mobile always is). */
  fit?: boolean;
  /**
   * No number tab / red column (Community Shortcuts); the body spans the full width.
   */
  noTab?: boolean;
  /** Position on the page (0-based): staggers the fade-in when the page opens. */
  index?: number;
  label?: string;
}

const {
  variant,
  number,
  active = false,
  height,
  tabletHeight,
  bare = false,
  fit = false,
  noTab = false,
  index = 0,
  label,
} = Astro.props;
const heightVars = [height && `--cf-h: ${height}px`, tabletHeight && `--cf-h-tablet: ${tabletHeight}px`, `--cf-i: ${index}`]
  .filter(Boolean)
  .join('; ');
---

<article
  class:list={[
    'cf',
    `cf--${variant}`,
    {
      'is-active': active,
      'cf--unnumbered': number === undefined,
      'cf--bare': bare,
      'cf--fit': fit,
      'cf--notab': noTab,
    },
  ]}
  data-cf
  aria-label={label}
  style={heightVars || undefined}
>
  <div class="cf__tab" aria-hidden={number === undefined ? 'true' : undefined}>
    {number !== undefined && <span class="cf__num">{number}</span>}
  </div>
  <div class="cf__body">
    <div class="cf__content">
      <slot />
    </div>
  </div>
</article>

<style>
  .cf {
    position: relative;
    width: 100%;
    height: var(--cf-h, var(--card-h));
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  /* Page open: containers fade in one after another, from the first — one 180ms step
     apart, the first one step in too (capped at 8 steps). */
  .cf {
    animation: cf-fade-in 600ms var(--ease-out) both;
    animation-delay: calc(min(var(--cf-i, 0) + 1, 8) * 180ms);
  }
  @keyframes cf-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cf {
      animation: none;
    }
  }

  .cf__body {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--num-col);
    right: 0;
    border: 1.5px solid var(--c-red-dim);
    background: var(--c-black);
    overflow: hidden;
    transition: border-color var(--t-state) ease;
  }
  .cf__content {
    height: 100%;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
  }

  /* Inactive: notch tab, open to the right so it merges with the body. */
  .cf__tab {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--num-col) + 2px);
    height: var(--notch-h);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 12px;
    border: 1.5px solid var(--c-red-dim);
    border-right: none;
    background: var(--c-black);
    z-index: 2;
    transition:
      height var(--t-state) var(--ease-out),
      background-color var(--t-state) ease,
      border-color var(--t-state) ease,
      padding var(--t-state) ease;
  }
  .cf__num {
    font-family: var(--f-ui);
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
    color: rgba(204, 24, 30, 0.6);
    transition: color var(--t-state) ease;
  }

  /* Active: solid red column down the full left side. */
  .cf.is-active .cf__tab {
    height: 100%;
    padding-top: 14px;
    background: var(--c-red);
    border-color: var(--c-red);
  }
  .cf.is-active .cf__num {
    color: var(--c-black);
  }
  .cf.is-active .cf__body {
    border: 2px solid var(--c-red);
  }
  .cf.is-active .cf__content,
  .cf:hover .cf__content,
  .cf:focus-within .cf__content {
    opacity: 1;
  }

  @media (max-width: 1279px) {
    .cf {
      height: var(--cf-h-tablet, var(--cf-h, var(--card-h)));
    }
    .cf__num {
      font-size: 38px;
    }
  }

  /* Bare: the body draws nothing; its content frames itself (and dims its own text). */
  .cf--bare .cf__body,
  .cf--bare.is-active .cf__body {
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .cf--bare .cf__content {
    opacity: 1;
  }

  .cf--notab .cf__tab {
    display: none;
  }
  .cf--notab .cf__body,
  .cf--notab.cf--fit .cf__body {
    left: 0;
    margin-left: 0;
  }

  /* Fit: the body sits in the flow (right of the red column), so the content sets the height. */
  @media (min-width: 768px) {
    .cf--fit {
      height: auto;
    }
    .cf--fit .cf__body {
      position: relative;
      inset: auto;
      margin-left: var(--num-col);
    }
    .cf--fit .cf__content {
      height: auto;
    }
  }

  /*
   * Games and Start cards (desktop/tablet, horizontal rows): the number sits in a bar along the TOP-LEFT —
   * a red bar across the left half of the top edge when selected, a notch tab otherwise.
   */
  @media (min-width: 768px) {
    /* Height comes from the content (16:9 art + text + buttons), not a fixed size. */
    .cf--game,
    .cf--start {
      height: auto;
    }
    .cf--game .cf__body,
    .cf--start .cf__body {
      position: relative;
      inset: auto;
      margin-top: var(--num-col);
    }
    .cf--game .cf__tab,
    .cf--start .cf__tab {
      width: var(--notch-h);
      height: calc(var(--num-col) + 2px);
      justify-content: flex-start;
      align-items: center;
      padding: 0 0 0 16px;
      border: 1.5px solid var(--c-red-dim);
      border-bottom: none;
      transition:
        width var(--t-state) var(--ease-out),
        background-color var(--t-state) ease,
        border-color var(--t-state) ease;
    }
    .cf--game.is-active .cf__tab,
    .cf--start.is-active .cf__tab {
      width: 50%;
      height: calc(var(--num-col) + 2px);
      padding: 0 0 0 16px;
      background: var(--c-red);
      border-color: var(--c-red);
    }
  }

  /* Mobile: number tab above the body. */
  @media (max-width: 767px) {
    .cf {
      --edge-w: 1.5px;
      height: auto;
      display: flex;
      flex-direction: column;
      /*
       * Transparent space below the box (still part of the container, so it scrolls and
       * snaps with it). Lets very short phones scroll the container until its button
       * clears the menu bar. Sized as the distance from the menu bar's top edge down to
       * the bottom of the scroll area (gap above footer + bar height), minus the box's
       * border: scrolled to the container's end, the box's bottom border sits exactly
       * under the menu bar's top border.
       */
      padding-bottom: calc(var(--menu-bar-bottom) - var(--footer-h) + var(--ctl-h) - var(--edge-w));
    }
    /* The last container's box ends at the expanded BACK TO TOP button instead (it sits
       above the menu bar): bottom of the scroll area up to that button's top edge. */
    .cf:last-child {
      padding-bottom: calc(var(--ctl-bottom) - var(--footer-h) + var(--ctl-h) - var(--edge-w));
    }
    .cf.is-active {
      --edge-w: 2px;
    }
    .cf__tab {
      position: relative;
      width: 86px;
      height: 38px;
      align-items: center;
      justify-content: flex-start;
      padding: 0 14px;
      margin-bottom: -1.5px;
      border: 1.5px solid var(--c-red-dim);
      border-bottom: none;
      transition:
        width var(--t-state) var(--ease-out),
        background-color var(--t-state) ease,
        border-color var(--t-state) ease;
    }
    .cf__num {
      font-size: 34px;
      color: var(--c-red);
    }
    .cf.is-active .cf__tab {
      width: 100%;
      height: 38px;
      padding: 0 14px;
      margin-bottom: 0;
    }
    .cf__body {
      position: relative;
      inset: auto;
      /* The bordered black box ends 14px below the last row. */
      padding: 14px;
    }
    .cf.is-active .cf__body {
      border-top: none;
    }
    /* No tab above it: the body keeps its top border. */
    .cf--notab.is-active .cf__body {
      border-top: 2px solid var(--c-red);
    }
    .cf--bare .cf__body {
      padding: 0;
    }
    .cf__content {
      height: auto;
    }
  }
</style>
