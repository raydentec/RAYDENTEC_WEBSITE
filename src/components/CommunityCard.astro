---
/**
 * One Community link section (no picture): brand icon tile + title (centred on it), description,
 * then the action button with its caption. Two of these sit side by side in each
 * Community container (pages/community.astro), each with its own black background and
 * red border — bright 2px when the container is selected, dim 1.5px otherwise, like the
 * standard frame. When the container is inactive the section's text dims, not its box.
 */
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';

interface Props {
  platform: string;
  icon: string;
  color: string;
  title: string;
  description: string;
  caption: string;
  href: string | null;
  buttonLabel: string;
}

const { platform, icon, color, title, description, caption, href, buttonLabel } = Astro.props;

// YouTube uses the filled play glyph; X and GitHub tiles get a light edge (dark fills).
const tileIcon = platform === 'youtube' ? 'play-filled' : icon;
const tileEdge = platform === 'x' || platform === 'github';
---

<section class="card" aria-label={title}>
  <div class="card__inner">
    <div class="card__head">
      <span class:list={['card__tile', { 'card__tile--edge': tileEdge }]} style={`background: ${color}`}>
        <Icon name={tileIcon} size={26} />
      </span>
      <h2 class="card__title">{title}</h2>
    </div>
    <p class="card__desc">{description}</p>
    <div class="card__actions">
      <LinkButton href={href} label={buttonLabel} class="card__btn" />
      <span class="card__caption">{caption}</span>
    </div>
  </div>
</section>

<style>
  .card {
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    /* Same spacing from the border on every side; content from the top, button at the bottom. */
    padding: 26px;
    border: 1.5px solid var(--c-red-dim);
    background: var(--c-black);
    transition: border-color var(--t-state) ease;
  }
  :global(.cf.is-active) .card {
    border: 2px solid var(--c-red);
  }
  .card__inner {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
  }
  :global(.cf.is-active) .card__inner,
  :global(.cf:hover) .card__inner,
  :global(.cf:focus-within) .card__inner {
    opacity: 1;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  /* Square brand tile (48px desktop, 42px tablet, 46px mobile). */
  .card__tile {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
  }
  .card__tile--edge {
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .card__title {
    min-width: 0;
    font-weight: 600;
    font-size: 28px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 22px;
    line-height: 1.08;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .card__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: auto;
  }
  .card :global(.card__btn) {
    width: 210px;
  }
  /* Fills the space to the section's right padding (as far from the border as the button). */
  .card__caption {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-grey);
  }

  @media (max-width: 1279px) {
    .card {
      padding: 20px;
    }
    .card__inner {
      gap: 12px;
    }
    .card__tile {
      width: 42px;
      height: 42px;
    }
    .card__head {
      gap: 14px;
    }
    .card__title {
      font-size: 23px;
    }
    .card__desc {
      font-size: 19px;
    }
    /* Narrower sections: caption under the button. */
    .card__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .card :global(.card__btn) {
      width: 200px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
    .card__caption {
      max-width: none;
      font-size: 13px;
    }
  }

  @media (max-width: 767px) {
    .card {
      height: auto;
      padding: 14px;
    }
    .card__inner {
      gap: 14px;
    }
    .card__head {
      gap: 16px;
    }
    .card__tile {
      width: 46px;
      height: 46px;
    }
    .card__title {
      font-size: 22px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    .card__actions {
      align-items: stretch;
      gap: 14px;
    }
    /* Full width, ↗ right after the label (the right end stays clear for the ↑ square). */
    .card :global(.card__btn) {
      width: 100%;
      justify-content: flex-start;
      gap: 14px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
    .card__caption {
      text-align: center;
    }
  }
</style>
