---
/** Community container body: inset image left, brand icon tile + text right (HANDOFF §5). */
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  platform: string;
  icon: string;
  color: string;
  eyebrow: string;
  title: string;
  description: string;
  caption: string;
  href: string | null;
  image: string;
  buttonLabel: string;
}

const { platform, icon, color, eyebrow, title, description, caption, href, image, buttonLabel } = Astro.props;

// YouTube uses the filled play glyph; X and GitHub tiles get a light edge (dark fills).
const tileIcon = platform === 'youtube' ? 'play-filled' : icon;
const tileEdge = platform === 'x' || platform === 'github';
---

<div class="card">
  <img class="card__media" src={asset(image)} alt="" width="426" height="239" loading="lazy" decoding="async" />
  <div class="card__text">
    <div class="card__head">
      <span class:list={['card__tile', { 'card__tile--edge': tileEdge }]} style={`background: ${color}`}>
        <Icon name={tileIcon} size={26} />
      </span>
      <div class="card__titles">
        <span class="eyebrow">{eyebrow}</span>
        <h2 class="card__title">{title}</h2>
      </div>
    </div>
    <p class="card__desc">{description}</p>
    <div class="card__actions">
      <LinkButton href={href} label={buttonLabel} class="card__btn" />
      <span class="card__caption">{caption}</span>
    </div>
  </div>
</div>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: 40px;
    height: 100%;
    padding: 0 36px 0 28px;
  }
  .card__media {
    width: min(426px, 48%);
    aspect-ratio: 426 / 239;
    height: auto;
    object-fit: cover;
    flex-shrink: 0;
  }
  .card__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-grow: 1;
    min-width: 0;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .card__tile {
    width: 74px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-white);
  }
  .card__tile--edge {
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .card__titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .card__title {
    font-weight: 600;
    font-size: 28px;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .card__desc {
    font-weight: 500;
    font-size: 25px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  .card__actions {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .card :global(.card__btn) {
    width: 225px;
  }
  .card__caption {
    max-width: 150px;
    font-family: var(--f-mono);
    font-size: 15px;
    line-height: 1.3;
    color: var(--c-grey);
  }

  @media (max-width: 1279px) {
    .card {
      gap: 28px;
      padding: 0 26px 0 24px;
    }
    .card__media {
      width: min(230px, 36%);
      aspect-ratio: 1;
    }
    .card__text {
      gap: 12px;
    }
    .card__tile {
      width: 64px;
      height: 42px;
    }
    .card__title {
      font-size: 25px;
    }
    .card__desc {
      font-size: 23px;
    }
    .card__actions {
      gap: 20px;
    }
    .card :global(.card__btn) {
      width: 210px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
    .card__caption {
      max-width: 140px;
      font-size: 13px;
    }
  }

  @media (max-width: 767px) {
    .card {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 0;
    }
    .card__media {
      width: 100%;
      height: 230px;
      aspect-ratio: auto;
    }
    .card__text {
      gap: 14px;
    }
    .card__head {
      gap: 16px;
    }
    .card__tile {
      width: 70px;
      height: 46px;
    }
    .card__titles {
      gap: 3px;
    }
    .card__title {
      font-size: 22px;
    }
    .card__desc {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    .card__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
    }
    /* Full width, ↗ right after the label (the right end stays clear for the ↑ square). */
    .card :global(.card__btn) {
      width: 100%;
      justify-content: flex-start;
      gap: 14px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
    .card__caption {
      max-width: none;
      text-align: center;
    }
  }
</style>
