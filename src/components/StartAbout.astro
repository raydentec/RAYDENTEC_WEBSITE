---
/**
 * Start · "About me": after the explore row, one container like the Projects containers
 * (ContainerFrame, top tab — here without a number, twice as wide), selected by snap.ts:
 * a 16:9 image cropped to half its height, a headline (the lead's first line, sized as the
 * game cards' titles), the lead paragraphs (sized as the game cards' descriptions) and a
 * button to the links (styled as the explore cards', StartCard.astro) with a short caption
 * beside it (as on the Projects containers). The section
 * headline sits above it and rides along with it
 * (its scroll-margin-top reaches up to the headline, as the Projects category headlines);
 * it is lit while the container is selected. Boxed to the content column like the explore
 * row's headline (--row-left / --row-w, Shell.astro).
 */
import ContainerFrame from './ContainerFrame.astro';
import LinkButton from './LinkButton.astro';
import { asset } from '../lib/content';

interface Props {
  title: string;
  image: string;
  imageAlt: string;
  lead: string;
  body: string;
  href: string;
  linkLabel: string;
}

const { title, image, imageAlt, lead, body, href, linkLabel } = Astro.props;
// The first line of the lead is the container's headline; the rest are paragraphs.
const [headline, ...leadParagraphs] = lead.split('\n');
---

<section class="about" aria-labelledby="about-title">
  <h2 class="about__title" id="about-title">{title}</h2>
  <ContainerFrame variant="start" index={3} label={title}>
    <div class="about__content">
      <img class="about__media" src={asset(image)} alt={imageAlt} width="1920" height="1080" loading="lazy" decoding="async" />
      <div class="about__lead">
        <h3 class="about__headline">{headline}</h3>
        {leadParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="about__actions">
        <LinkButton href={href} label={linkLabel} class="about__btn" />
        <p class="about__body">{body.split('\n').map((line, i) => (i ? [<br />, line] : line))}</p>
      </div>
    </div>
  </ContainerFrame>
</section>

<style>
  .about {
    /* Headline → first container (the headline is --row-title tall, line-height 1). */
    --title-gap: 24px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--card-gap);
    width: var(--row-w);
    margin: 48px 0 0 var(--row-left);
  }

  /* Headline: as the explore row's (GameRow.astro); dimmed while the container isn't
     selected. */
  .about__title {
    margin-bottom: calc(var(--title-gap) - var(--card-gap));
    font-weight: 700;
    font-size: var(--row-title);
    line-height: 1;
    letter-spacing: -0.03em;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
  }
  .about:has(:global(.cf.is-active)) .about__title {
    opacity: 1;
  }
  /* The container snaps with the headline on top. */
  .about__title + :global(.cf) {
    scroll-margin-top: calc(var(--row-title) + var(--title-gap));
  }
  /* A container that isn't selected can be clicked to scroll to it (scripts/snap.ts). */
  .about :global(.cf:not(.is-active)) {
    cursor: pointer;
  }

  /*
   * The last container ends a container gap (--card-gap, as between the Projects
   * containers) above the footer when scrolled to the end on a short window; the space is
   * part of the container, so the column can scroll to it (as the last project container,
   * pages/projects.astro). Mobile: the frame, as the page's last container, already leaves
   * room down to the BACK TO TOP control (ContainerFrame.astro).
   */
  @media (min-width: 768px) {
    .about :global(.cf:last-child) {
      padding-bottom: var(--card-gap);
    }
  }

  /* Inside the frames' bodies (dimmed / lit by ContainerFrame). */
  .about__content {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px 36px 28px 28px;
  }
  /* The 16:9 image cropped to half its height, centred. */
  .about__media {
    width: 100%;
    height: auto;
    aspect-ratio: 32 / 9;
    object-fit: cover;
    object-position: center;
  }

  /*
   * Frame tab (ContainerFrame): twice the usual notch width while not selected; selected,
   * as wide as a selected game card's tab (half a game card: ⅓ of the column). Mobile:
   * the selected tab spans the whole width, as on every container there.
   */
  @media (min-width: 768px) {
    .about :global(.cf.cf--start .cf__tab) {
      width: calc(2 * var(--notch-h));
    }
    .about :global(.cf.cf--start.is-active .cf__tab) {
      width: calc(var(--row-w) / 3);
    }
  }

  /* Lead: as the game cards' descriptions (GameCard.astro). */
  .about__lead {
    font-weight: 500;
    font-size: 23px;
    line-height: 1.04;
    letter-spacing: -0.05em;
    color: var(--c-grey);
  }
  /* Paragraphs a full line apart. */
  .about__lead {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }
  /* Headline (the lead's first line: name and tagline): as the game cards' titles (GameCard.astro). */
  .about__headline {
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-white);
  }

  /* Body: smaller grey text below the lead. */
  /* Button with the body text as a caption to its right (below it on mobile), as on the
     Projects containers (ProjectCard.astro). */
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
  }
  .about__body {
    flex: 1 1 120px;
    min-width: 0;
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-grey);
  }

  /* As the explore cards' buttons (StartCard.astro): as wide as the label needs. */
  .about :global(.about__btn) {
    flex-shrink: 0;
    min-width: 210px;
    gap: 20px;
  }

  @media (max-width: 1279px) {
    .about {
      --title-gap: 20px;
      margin-top: 40px;
    }
    .about__content {
      gap: 24px;
      padding: 24px 26px 24px 24px;
    }
    .about__headline {
      font-size: 27px;
    }
    .about__lead {
      font-size: 20px;
    }
    .about__body {
      font-size: 13px;
    }
    .about :global(.about__btn) {
      min-width: 200px;
      --btn-h: 52px;
      --btn-font: 20px;
      padding: 0 18px 0 26px;
    }
  }

  /* Mobile: in the padded column. Above it: the explore row's room down to
     the menu bar plus the usual container gap, as between two Games rows (GameRow.astro).
     The frames pad their bodies by 14px (ContainerFrame). */
  @media (max-width: 767px) {
    .about {
      --title-gap: 14px;
      width: auto;
      margin: var(--card-gap) 0 0;
    }
    .about__content {
      gap: 22px;
      padding: 4px 2px 8px;
    }
    .about__lead {
      font-size: 21px;
      line-height: 1.25;
      letter-spacing: -0.045em;
    }
    .about__headline {
      font-size: 26px;
    }
    /* Stacked: full-width button, caption centred under it (as the Projects containers). */
    .about__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .about__body {
      flex: none;
      text-align: center;
    }
    /* Full width, ↗ right after the label (as the explore cards). */
    .about :global(.about__btn) {
      align-self: stretch;
      min-width: 0;
      justify-content: flex-start;
      gap: 14px;
      --btn-h: 52px;
      --btn-font: 22px;
      padding: 0 18px 0 24px;
    }
    .about :global(.cf.cf--start .cf__tab) {
      width: calc(2 * 86px);
    }
    .about :global(.cf.cf--start.is-active .cf__tab) {
      width: 100%;
    }
  }
</style>
