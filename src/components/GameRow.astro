---
/**
 * One sideways row of games (Games page), headed by its category. The column snaps
 * between rows — at the headline — like it snaps between containers on other pages;
 * inside a row the games scroll and snap sideways (scripts/game-rows.ts). Instead of a scrollbar, an indicator above the
 * row shows one line per game — together as wide as a selected game's red top bar — with
 * the current game's line lit; clicking a line scrolls to that game. The lines are left
 * out of the Tab order — on the keyboard ← / → step through the row (game-rows.ts).
 *
 * Opening the page: the rows fade in one after another like containers on other pages
 * (the games in them don't fade in on their own).
 *
 * Mobile: the same, with games 85% of the column wide so the next one peeks in. The red
 * bar spans the whole selected game there (ContainerFrame), and so does the indicator.
 *
 * Also the Start page's "What you can find here" row (StartExplore.astro), with its own
 * card widths (`class`) and `lit`.
 */
interface Props {
  /** Headline: the games' category. */
  title: string;
  /** Titles of the games in the row, for the indicator buttons. */
  titles: string[];
  /** Position of the row's first game on the page (0-based). */
  index: number;
  /** Position of the row on the page (0-based): staggers its fade-in. */
  row: number;
  active?: boolean;
  /**
   * Headline, indicator and current card stay lit (and clickable) while the row isn't the
   * selected container (Start: the row peeks in under the hero).
   */
  lit?: boolean;
  /** Item label for the indicator buttons ("Show …" / "… in"). */
  itemsLabel?: string;
  class?: string;
}

const { title, titles, index, row, active = false, lit = false, itemsLabel = 'Games', class: className } = Astro.props;
const headingId = `games-${index}`;
---

<section
  class:list={['grow', className, { 'is-active': active, 'grow--lit': lit }]}
  data-cf
  data-row
  data-row-lit={lit ? '' : undefined}
  aria-labelledby={headingId}
  style={`--row-i: ${row}`}
>
  <h2 class="grow__title" id={headingId}>{title}</h2>
  <div class="grow__dots" role="group" aria-label={`${itemsLabel} in ${title}`}>
    {
      titles.map((game, i) => (
        <button type="button" class="grow__dot" data-row-dot tabindex="-1" aria-label={`Show ${game}`} aria-current={i === 0 ? 'true' : undefined} />
      ))
    }
  </div>
  <div class="grow__track" data-row-track>
    <div class="grow__list">
      <slot />
    </div>
  </div>
</section>

<style>
  .grow {
    /* --row-left / --row-w: the usual column's left edge and width (Shell.astro). */
    --game-w: calc(var(--row-w) * 2 / 3);
    display: flex;
    flex-direction: column;
    gap: 8px;
    scroll-snap-align: start;
  }

  /* Headline: lined up with the games' left edge; dimmed with the indicator while the
     row isn't selected. */
  .grow__title {
    margin-left: var(--row-left);
    padding-right: var(--gutter);
    font-weight: 700;
    font-size: var(--row-title);
    line-height: 1;
    letter-spacing: -0.03em;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
  }
  /* Rows that aren't selected can't be clicked or hovered (wheel / touch input goes to the
     column underneath, so scrolling to them still works). */
  .grow:not(.is-active, .grow--lit) {
    pointer-events: none;
  }
  .grow--lit .grow__title,
  .grow.is-active .grow__title,
  .grow:hover .grow__title,
  .grow:focus-within .grow__title {
    opacity: 1;
  }

  /* Indicator: lined up with the games' left edge, as wide as the red top bar (half a game). */
  .grow__dots {
    display: flex;
    gap: 8px;
    width: calc(var(--game-w) / 2);
    margin-left: var(--row-left);
  }

  /* Page open: whole rows fade in one 180ms step apart, the first one step in too (as
     ContainerFrame does for containers); the games inside don't animate on their own. */
  .grow {
    animation: grow-fade-in 600ms var(--ease-out) both;
    animation-delay: calc(min(var(--row-i, 0) + 1, 8) * 180ms);
  }
  .grow .grow__list > :global(.cf) {
    animation: none;
  }
  @keyframes grow-fade-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grow {
      animation: none;
    }
  }
  /* One line per game; the button is taller than the line for an easier hit. */
  .grow__dot {
    position: relative;
    flex: 1 1 0;
    height: 12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: var(--o-inactive);
    transition: opacity var(--t-state) ease;
  }
  .grow__dot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    background: var(--c-white);
    opacity: 0.35;
    transition:
      background-color var(--t-state) ease,
      opacity var(--t-state) ease;
  }
  .grow__dot:hover::before {
    opacity: 0.7;
  }
  .grow__dot[aria-current='true']::before {
    background: var(--c-red);
    opacity: 1;
  }
  .grow--lit .grow__dot,
  .grow.is-active .grow__dot,
  .grow:hover .grow__dot,
  .grow:focus-within .grow__dot {
    opacity: 1;
  }

  /* Sideways track: no scrollbar; snaps each game to the column's left edge. */
  .grow__track {
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--row-left);
    scrollbar-width: none;
  }
  .grow__track::-webkit-scrollbar {
    display: none;
  }
  /* Games ⅔ of the column wide, --games-gap (Shell.astro) apart at every size; the right padding lets the
     last one snap to the left edge too. */
  .grow__list {
    display: flex;
    align-items: flex-start;
    gap: var(--games-gap);
    width: max-content;
    padding: 0 calc(100vw - var(--row-left) - var(--game-w)) 0 var(--row-left);
  }
  .grow__list > :global(.cf) {
    flex: 0 0 var(--game-w);
  }

  /*
   * Mobile: the column is padded by the gutter, so headline and indicator line up by
   * themselves; the track reaches out to both screen edges. The transparent space below
   * the box (see ContainerFrame) moves from the games to the row.
   */
  @media (max-width: 767px) {
    .grow {
      --row-left: var(--gutter);
      --row-w: calc(100vw - 2 * var(--gutter));
      --game-w: calc(var(--row-w) * 0.85);
      padding-bottom: calc(var(--menu-bar-bottom) - var(--footer-h) + var(--ctl-h) - 2px);
    }
    .grow:last-child {
      padding-bottom: calc(var(--ctl-bottom) - var(--footer-h) + var(--ctl-h) - 2px);
    }
    .grow__title {
      margin-left: 0;
      padding-right: 0;
    }
    .grow__dots {
      width: var(--game-w);
      margin-left: 0;
    }
    .grow__track {
      margin: 0 calc(-1 * var(--gutter));
    }
    .grow .grow__list > :global(.cf) {
      padding-bottom: 0;
    }
  }
</style>
