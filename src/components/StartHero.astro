---
/**
 * Start · hero: the first of the page's two snap sections (container 0 for snap.ts).
 * A full-bleed image slider (overlaid for legibility) that fades out below the lower third
 * via a mask, revealing the page background, and the lower third ending 16px above the
 * explore headline. The slides scroll and snap sideways (swipe / trackpad / Shift+wheel)
 * and switch on a timer (scripts/hero-slider.ts); an indicator like the Games rows'
 * (GameRow.astro) — current slide white — sits above the lower third's left edge, and
 * clicking a line shows that slide. Copies of the last slide before the first and of the
 * first after the last let the slider go round both ways instead of rewinding. With one
 * image there is nothing to slide: no copies, indicator, scrolling or timer.
 *
 * The hero is shorter than the scroll area, so the explore row (StartExplore.astro) peeks
 * in below it: its cards' top edge lines up with the top of the scroll control. Hero
 * height = viewport − scroller top − (scroll control's top edge from the viewport bottom)
 * − the explore row's headline + indicator (--row-head, GameRow.astro).
 */
import LowerThird from './LowerThird.astro';
import { asset } from '../lib/content';

interface Props {
  images: string[];
  imageAlt: string;
  imagePosition: { desktop: string; tablet: string; mobile: string };
  name: string;
  tagline: string;
  handle: string;
  bio: string;
  joinPrompt: string;
  ctas: { label: string; href: string; variant: 'primary' | 'secondary' }[];
}

const { images, imageAlt, imagePosition, ...identity } = Astro.props;
// Track: [copy of last] slides… [copy of first] — no copies for a single image.
const looped = images.length > 1;
const slides = [
  ...(looped ? [{ image: images[images.length - 1], clone: true }] : []),
  ...images.map((image) => ({ image, clone: false })),
  ...(looped ? [{ image: images[0], clone: true }] : []),
];
const first = looped ? 1 : 0;
const positions = `--pos-desktop: ${imagePosition.desktop}; --pos-tablet: ${imagePosition.tablet}; --pos-mobile: ${imagePosition.mobile}`;
---

<div class="hero is-active" data-cf data-hero data-slider style={positions}>
  <div class="hero__art" aria-hidden={imageAlt ? undefined : 'true'}>
    <div class:list={['hero__track', { 'hero__track--single': images.length < 2 }]} data-slide-track>
      {
        slides.map(({ image, clone }, i) => (
          <img
            class="hero__img"
            data-slide={clone ? undefined : ''}
            data-slide-clone={clone ? '' : undefined}
            src={asset(image)}
            alt={clone ? '' : imageAlt}
            width="1920"
            height="1080"
            decoding="async"
            draggable="false"
            loading={i === first ? 'eager' : 'lazy'}
            fetchpriority={i === first ? 'high' : undefined}
          />
        ))
      }
    </div>
  </div>
  <div class="hero__front">
    {
      images.length > 1 && (
        <div class="hero__dots" role="group" aria-label="Hero images">
          {images.map((_, i) => (
            <button
              type="button"
              class="hero__dot"
              data-slide-dot
              aria-label={`Show image ${i + 1} of ${images.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )
    }
    <LowerThird {...identity} />
  </div>
</div>

<style>
  .hero {
    /* Scroller top edge in the viewport (Shell.astro: 0 on desktop/tablet). */
    --scroller-top: 0px;
    position: relative;
    /* The whole hero fades out on the way to the explore row and back in on the way up
       (--hero-art, scripts/start.ts). */
    opacity: var(--hero-art, 1);
    height: calc(100dvh - var(--scroller-top) - var(--ctl-bottom) - var(--ctl-h) - var(--row-head));
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  /* Not selected (the explore row is): no clicks or hovers, as rows on Games — wheel and
     touch input go to the column underneath. */
  .hero:not(.is-active) {
    pointer-events: none;
  }

  /* Viewport-tall, so it runs on under the explore row's peek; masked out below the lower third. */
  .hero__art {
    --fade-from: 64%;
    --fade-to: 84%;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100dvh - var(--scroller-top));
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 var(--fade-from), transparent var(--fade-to));
    mask-image: linear-gradient(180deg, #000 0%, #000 var(--fade-from), transparent var(--fade-to));
  }
  .hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 22%, rgba(0, 0, 0, 0) 42%, rgba(0, 0, 0, 0.5) 70%);
    pointer-events: none;
  }
  /* Slides side by side, one per screen width, snapping (as the Games rows' tracks); no
     scrollbar — the indicator replaces it. Vertical wheel / swipes go on to the page. */
  .hero__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hero__track::-webkit-scrollbar {
    display: none;
  }
  .hero__track--single {
    overflow-x: hidden;
  }
  .hero__img {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-desktop);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    user-select: none;
  }
  /* The copies only become snap points once the slider is set up (data-ready,
     scripts/hero-slider.ts): until then the track settles on the first real slide, not
     on the copy of the last one before it. */
  .hero__track:not([data-ready]) .hero__img[data-slide-clone] {
    scroll-snap-align: none;
  }

  /* Indicator, then the lower third, 16px above the explore headline. */
  .hero__front {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* As the Games rows' indicator (GameRow.astro): one line per slide, lined up with the
     lower third's content (inside its left padding, LowerThird.astro: 28px, tablet 24px,
     mobile 18px both sides) and as wide as its CTA buttons (318px, tablet 306px, mobile the
     full content width); the current slide's line is white. */
  .hero__dots {
    display: flex;
    gap: 8px;
    width: 318px;
    margin-left: 28px;
  }
  .hero__dot {
    position: relative;
    flex: 1 1 0;
    height: 12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .hero__dot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    background: var(--c-white);
    opacity: 0.35;
    transition: opacity var(--t-state) ease;
  }
  .hero__dot:hover::before {
    opacity: 0.7;
  }
  .hero__dot[aria-current='true']::before {
    opacity: 1;
  }

  @media (max-width: 1279px) {
    .hero__art {
      --fade-from: 65%;
      --fade-to: 85%;
    }
    .hero__img {
      object-position: var(--pos-tablet);
    }
    .hero__dots {
      width: 306px;
      margin-left: 24px;
    }
  }

  /* Mobile: the scroller starts under the top bar; the hero reaches out over its gutters. */
  @media (max-width: 767px) {
    .hero {
      --scroller-top: var(--top-bar);
      margin: 0 calc(-1 * var(--gutter));
    }
    .hero__art {
      --fade-from: 62%;
      --fade-to: 82%;
    }
    .hero__img {
      object-position: var(--pos-mobile);
    }
    .hero__dots {
      width: auto;
      margin-inline: 18px;
    }
  }
</style>
