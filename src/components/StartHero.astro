---
/**
 * Start · hero: the first of the page's two snap sections (container 0 for snap.ts).
 * A full-bleed image slider (overlaid for legibility) that fades out below the lower third
 * via a mask, revealing the page background, and the lower third ending 16px above the
 * explore headline. The slides scroll and snap sideways (swipe / trackpad / Shift+wheel)
 * and switch on a timer (scripts/hero-slider.ts); an indicator like the Games rows'
 * (GameRow.astro) — current slide white — sits above the lower third's left edge, and
 * clicking a line shows that slide. Arrow buttons at the left and right edges (in line with
 * the lower third's edges, vertically centred between the nav and the hero's bottom) show
 * the previous / next slide (not on mobile: swipe). Copies of the last slide before the
 * first and of the first after the last let the slider go round both ways instead of rewinding. With one
 * image there is nothing to slide: no copies, indicator, arrows, scrolling or timer.
 * Image placement (object-position) per layout from imagePosition; on mobile a slide can
 * have its own (images[].mobilePosition, content/start.json).
 *
 * The hero is shorter than the scroll area, so the explore row (StartExplore.astro) peeks
 * in below it: its cards' top edge lines up with the top of the scroll control. Hero
 * height = viewport − scroller top − (scroll control's top edge from the viewport bottom)
 * − the explore row's headline + indicator (--row-head, GameRow.astro). Mobile: as tall as
 * the scroll area (nothing of the explore row shows below it at the top, as the containers
 * on other pages come after their info area), but at least as it takes to show 180px of
 * picture plus the lower third's height more — scrolled around freely where that's taller
 * than the screen; under the lower third, the same empty space as under the info area
 * (clear of the bottom controls).
 */
import BgToggle from './BgToggle.astro';
import Icon from './Icon.astro';
import LowerThird from './LowerThird.astro';
import { asset } from '../lib/content';

interface Props {
  /** mobilePosition: this slide's own mobile object-position (else imagePosition.mobile);
      portrait: an upright image for phones held upright (PORTRAIT_MEDIA), placed by
      portraitPosition (else center). */
  images: { src: string; mobilePosition?: string; portrait?: string; portraitPosition?: string }[];
  imageAlt: string;
  imagePosition: { desktop: string; tablet: string; mobile: string };
  name: string;
  tagline: string;
  handle: string;
  bio: string;
  joinPrompt: string;
  ctas: { label: string; href: string; variant: 'primary' | 'secondary' }[];
}

const { images, imageAlt, imagePosition, ...identity } = Astro.props;
// Track: [copy of last] slides… [copy of first] — no copies for a single image.
const looped = images.length > 1;
const slides = [
  ...(looped ? [{ image: images[images.length - 1], clone: true }] : []),
  ...images.map((image) => ({ image, clone: false })),
  ...(looped ? [{ image: images[0], clone: true }] : []),
].map(({ image, clone }) => ({
  src: image.src,
  portrait: image.portrait,
  clone,
  // Overrides the hero's --pos-mobile / --pos-portrait for this slide (and its copy).
  style:
    [
      image.mobilePosition && `--pos-mobile: ${image.mobilePosition}`,
      image.portraitPosition && `--pos-portrait: ${image.portraitPosition}`,
    ]
      .filter(Boolean)
      .join('; ') || undefined,
}));
// Phones held upright: a slide's portrait image instead (the same query as its CSS below).
const PORTRAIT_MEDIA = '(max-width: 767px) and (orientation: portrait)';
const first = looped ? 1 : 0;
const positions = `--pos-desktop: ${imagePosition.desktop}; --pos-tablet: ${imagePosition.tablet}; --pos-mobile: ${imagePosition.mobile}`;
---

<div class="hero is-active" data-cf data-hero data-slider data-bottom-space style={positions}>
  <div class="hero__art" aria-hidden={imageAlt ? undefined : 'true'}>
    <div class:list={['hero__track', { 'hero__track--single': images.length < 2 }]} data-slide-track>
      {
        slides.map(({ src, portrait, clone, style }, i) => {
          const img = (
            <img
              class:list={['hero__img', { 'hero__img--portrait': portrait }]}
              data-slide={clone ? undefined : ''}
              data-slide-clone={clone ? '' : undefined}
              src={asset(src)}
              style={style}
              alt={clone ? '' : imageAlt}
              width="1920"
              height="1080"
              decoding="async"
              draggable="false"
              loading={i === first ? 'eager' : 'lazy'}
              fetchpriority={i === first ? 'high' : undefined}
            />
          );
          // <picture> lays out as if it weren't there (display: contents): the img stays the
          // track's slide.
          return portrait ? (
            <picture class="hero__pic">
              <source media={PORTRAIT_MEDIA} srcset={asset(portrait)} width="1080" height="1920" />
              {img}
            </picture>
          ) : (
            img
          );
        })
      }
    </div>
  </div>
  {
    looped && (
      <>
        <button type="button" class="hero__arrow hero__arrow--prev" data-slide-prev aria-label="Previous image">
          <Icon name="chevron" size={56} />
        </button>
        <button type="button" class="hero__arrow hero__arrow--next" data-slide-next aria-label="Next image">
          <Icon name="chevron" size={56} />
        </button>
      </>
    )
  }
  <div class="hero__front">
    {
      images.length > 1 && (
        <div class="hero__dots" role="group" aria-label="Hero images">
          {images.map((_, i) => (
            <button
              type="button"
              class="hero__dot"
              data-slide-dot
              aria-label={`Show image ${i + 1} of ${images.length}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))}
        </div>
      )
    }
    <LowerThird {...identity} />
  </div>
  <BgToggle class="hero__bg" />
</div>

<style>
  .hero {
    /* Scroller top edge in the viewport (Shell.astro: 0 on desktop/tablet). */
    --scroller-top: 0px;
    position: relative;
    /* The whole hero fades out on the way to the explore row and back in on the way up
       (--hero-art, scripts/start.ts). */
    opacity: var(--hero-art, 1);
    height: calc(100dvh - var(--scroller-top) - var(--ctl-bottom) - var(--ctl-h) - var(--row-head));
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  /* Background switch, mobile only (tablet and up use the fixed one, Shell.astro): top
     right of the hero, placed as that fixed one — top on the nav row, right edge in line
     with the scroll control's. It scrolls away with the hero. */
  .hero :global(.bg-toggle.hero__bg) {
    display: none;
  }
  @media (max-width: 767px) {
    .hero :global(.bg-toggle.hero__bg) {
      display: flex;
      position: absolute;
      top: calc(var(--nav-top) - var(--scroller-top));
      right: var(--ctl-right);
      width: calc(var(--ctl-h) / 2);
      height: calc(var(--ctl-h) / 2);
      z-index: 2;
    }
  }
  /* Not selected (the explore row is): no clicks or hovers, as rows on Games — wheel and
     touch input go to the column underneath. */
  .hero:not(.is-active) {
    pointer-events: none;
  }
  /* On its way in (a glide back up is heading to it, scripts/dom.ts markArriving): what
     switches slides already works — swiping the slides (the track only), the indicator
     lines and the arrows; the lower third's links wait until it's selected. */
  .hero[data-arriving]:not(.is-active) .hero__track,
  .hero[data-arriving]:not(.is-active) .hero__dots,
  .hero[data-arriving]:not(.is-active) .hero__arrow {
    pointer-events: auto;
  }
  .hero[data-arriving]:not(.is-active) .hero__track * {
    pointer-events: none;
  }

  /* Viewport-tall, so it runs on under the explore row's peek; masked out below the lower third. */
  .hero__art {
    --fade-from: 64%;
    --fade-to: 84%;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100dvh - var(--scroller-top));
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 var(--fade-from), transparent var(--fade-to));
    mask-image: linear-gradient(180deg, #000 0%, #000 var(--fade-from), transparent var(--fade-to));
  }
  .hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0) 22%, rgba(0, 0, 0, 0) 42%, rgba(0, 0, 0, 0.5) 70%);
    pointer-events: none;
  }
  /* Slides side by side, one per screen width, snapping (as the Games rows' tracks); no
     scrollbar — the indicator replaces it. Vertical wheel / swipes go on to the page. */
  .hero__track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    /* No rubber-band bounce at either end (iOS: it jerked under repeated swipes). */
    overscroll-behavior-x: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  /* Gliding to a slide by script (scripts/hero-slider.ts): snapping paused, or Safari /
     Firefox would pull each frame's position back to the nearest slide. */
  .hero__track[data-gliding] {
    scroll-snap-type: none;
  }
  /* A slide change under way (scripts/hero-slider.ts): input is ignored until it has
     finished — a finger can't pan the track sideways meanwhile (vertical still scrolls). */
  .hero__track[data-switching] {
    touch-action: pan-y;
  }
  /* iPhone / iPad: sideways touch is the script's alone (scripts/ios-swipe.ts), as the rows'. */
  :global(html[data-ios-touch]) .hero__track {
    touch-action: pan-y;
    overflow-x: hidden;
    scroll-snap-type: none;
  }
  /* Not Chromium (WebKit): room past the last copy, so dragging on from it never reaches the
     edge (no rubber-band; the release glides back — scripts/dom.ts stopEdgeBounce). */
  :global(html[data-glide-script]) .hero__track::after {
    content: '';
    flex: 0 0 50%;
  }
  .hero__track::-webkit-scrollbar {
    display: none;
  }
  .hero__track--single {
    overflow-x: hidden;
  }
  .hero__img {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-desktop);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    user-select: none;
  }
  /* The copies only become snap points once the slider is set up (data-ready,
     scripts/hero-slider.ts): until then the track settles on the first real slide, not
     on the copy of the last one before it. */
  .hero__track:not([data-ready]) .hero__img[data-slide-clone] {
    scroll-snap-align: none;
  }

  /* Previous / next arrows: control-sized squares at the gutters (the lower third's left
     and right edges), vertically centred between the nav's bottom edge and the hero's
     bottom — but at least 16px above the indicator (short windows: the lower third
     is --lt-h tall, scripts/start.ts; the indicator is 12px + 12px gap above it, all 16px
     above the hero's bottom). A translucent white fill over the blurred image, white
     chevron (filling the square, its own margins included). */
  .hero__arrow {
    position: absolute;
    z-index: 1;
    top: min(
      calc((var(--nav-top) + var(--nav-h) + 100% - var(--ctl-h)) / 2),
      calc(100% - 16px - var(--lt-h, 380px) - 24px - 16px - var(--ctl-h))
    );
    width: var(--ctl-h);
    height: var(--ctl-h);
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    /* Half the controls' 50% white fill; hovered, the full one. */
    background: rgba(255, 255, 255, 0.25);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--c-white);
    cursor: pointer;
    transition: background-color var(--t-state) ease;
  }
  .hero__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }
  .hero__arrow:hover {
    background: var(--c-control-fill);
  }
  .hero__arrow:focus-visible {
    outline: 2px solid var(--c-white);
    outline-offset: 2px;
  }
  .hero__arrow--prev {
    left: var(--gutter);
  }
  .hero__arrow--prev :global(svg) {
    transform: rotate(180deg);
  }
  .hero__arrow--next {
    right: var(--gutter);
  }

  /* Indicator, then the lower third, 16px above the explore headline. */
  .hero__front {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* As the Games rows' indicator (GameRow.astro): one line per slide, lined up with the
     lower third's content (inside its left padding, LowerThird.astro: 28px, tablet 24px,
     mobile 18px both sides) and as wide as its CTA buttons (318px, tablet 306px, mobile the
     full content width); the current slide's line is white. */
  .hero__dots {
    display: flex;
    gap: 8px;
    width: 318px;
    margin-left: 28px;
  }
  .hero__dot {
    position: relative;
    flex: 1 1 0;
    height: 12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .hero__dot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    transform: translateY(-50%);
    background: var(--c-white);
    opacity: 0.35;
    transition: opacity var(--t-state) ease;
  }
  /* Only where there's a real pointer to hover with: Chrome on Android kept a tapped line
     "hovered" (lit) after the slider had moved on, until something else was tapped. */
  @media (hover: hover) {
    .hero__dot:hover::before {
      opacity: 0.7;
    }
  }
  .hero__dot[aria-current='true']::before {
    opacity: 1;
  }

  @media (max-width: 1279px) {
    .hero__art {
      --fade-from: 65%;
      --fade-to: 85%;
    }
    .hero__img {
      object-position: var(--pos-tablet);
    }
    .hero__dots {
      width: 306px;
      margin-left: 24px;
    }
  }

  /* Phones turned sideways (touch, landscape, at most 540px tall; the tablet layout): the
     screen-based height left almost no picture above the lower third and the explore row
     showing under it. At least as tall as the picture above the lower third being as tall as
     the lower third (--lt-h, scripts/start.ts): picture + indicator (12px) + gap (12px) +
     lower third + 16px under it. Taller than the screen: scrolled through, then on. */
  @media (orientation: landscape) and (pointer: coarse) and (max-height: 540px) {
    .hero {
      min-height: calc(var(--lt-h, 200px) * 2 + 12px + 12px + 16px);
    }
  }

  /* Mobile: the scroller starts under the top bar; the hero reaches out over its gutters. */
  @media (max-width: 767px) {
    /* The whole scroll area (top bar down to the footer), so nothing of the explore row
       shows below it at the top of the page — as the info area on other pages (.mprofile,
       Shell.astro; Start has no padding above it). At least (min-height): --min-strip of
       the picture plus the lower third's height more, above the indicator (below it: the
       indicator's 12px gap, the lower third — --lt-h from scripts/start.ts — and the empty
       space under it, --bottom-space); on all but very tall phones that's taller than the
       screen, and the wheel / keys / touch scroll freely through it before moving on to the
       explore row (scripts/wheel.ts, snap.ts).
       --bottom-space: empty space at the bottom, as under the info area (.mprofile__spacer,
       Shell.astro): the bottom controls (menu bar + SCROLL / back-to-top + gaps) + 16px, so
       the CTAs can scroll clear of them (data-bottom-space: scrolling counts it as the
       space under the controls, scripts/dom.ts snapSpans). */
    .hero {
      --scroller-top: var(--top-bar);
      --min-strip: 180px;
      --bottom-space: calc(var(--ctl-bottom) - var(--footer-h) + var(--ctl-h) + 16px);
      margin: 0 calc(-1 * var(--gutter));
      height: calc(100dvh - var(--top-bar) - var(--footer-h));
      min-height: calc(var(--min-strip) + var(--lt-h, 380px) + 24px + var(--lt-h, 380px) + var(--bottom-space));
    }
    .hero__front {
      bottom: var(--bottom-space);
    }
    /* Only as tall as the hero (down to the explore row's top); the image fades out across
       the lower third, from its top edge to its bottom edge (--lt-h: its height, measured
       by scripts/start.ts; it sits --bottom-space above the hero's bottom). */
    .hero__art {
      --fade-from: calc(100% - var(--bottom-space) - var(--lt-h, 380px));
      --fade-to: calc(100% - var(--bottom-space));
      height: 100%;
    }
    .hero__img {
      object-position: var(--pos-mobile);
    }
    /* Swipe instead of arrows. */
    .hero__arrow {
      display: none;
    }
    .hero__dots {
      width: auto;
      margin-inline: 18px;
    }
  }

  /* Phones held upright (PORTRAIT_MEDIA above): a slide with a portrait image shows that
     instead (<picture>), placed by its portraitPosition (--pos-portrait, else centred). */
  .hero__pic {
    display: contents;
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .hero__img--portrait {
      object-position: var(--pos-portrait, center);
    }
  }
</style>
