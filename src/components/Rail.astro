---
/**
 * Collapsed sidebar rail: logo, EXPAND, and "Join me:" VIDEOS / SOCIALS.
 * Desktop: shown when <html data-sidebar="collapsed">. Tablet: always shown.
 */
import Icon from './Icon.astro';
import { getSite, linkAttrs } from '../lib/content';

const site = await getSite();
const [videos, socials] = site.ctas;
---

<div class="rail" data-rail transition:persist="rail">
  <img class="rail__logo" src="/assets/logo.png" alt="RAYDENTEC" width="56" height="56" />
  <button
    type="button"
    class="rail__expand ctl"
    data-sidebar-expand
    aria-controls="sidebar"
    aria-expanded="false"
    aria-label="Expand profile sidebar"
  >
    <Icon name="arrowRight" size={30} />
    <span class="rail__expand-label" aria-hidden="true">EXPAND</span>
  </button>
  <div class="rail__join">
    <p class="rail__join-label">Join me:</p>
    <a class="rail__cta rail__cta--primary" aria-label={videos.label} {...linkAttrs(videos.href)}>
      <Icon name="arrowUR" size={22} />
      <span aria-hidden="true">VIDEOS</span>
    </a>
    <a class="rail__cta rail__cta--outline" aria-label={socials.label} {...linkAttrs(socials.href)}>
      <Icon name="arrowUR" size={22} />
      <span aria-hidden="true">SOCIALS</span>
    </a>
  </div>
</div>

<style>
  /*
   * The rail sits above the content column (z 1) and the sidebar box (z 4), so it never
   * slips under content (Games rows run under it).
   *
   * It fades in (after the sidebar has faded out) and out part by part — logo, EXPAND,
   * Join me — not as a whole: opacity on the rail itself would cut EXPAND's backdrop blur
   * off from what's behind the rail until the fade ended. --rail-fade is that fade.
   */
  .rail {
    position: relative;
    z-index: 5;
    visibility: hidden;
    transition: visibility 0s linear var(--t-fade);
  }
  :global(html[data-sidebar='collapsed']) .rail {
    visibility: visible;
    transition: none;
  }
  .rail__logo,
  .rail__expand,
  .rail__join {
    --rail-fade: opacity var(--t-fade) ease;
    opacity: 0;
  }
  :global(html[data-sidebar='collapsed']) .rail__logo,
  :global(html[data-sidebar='collapsed']) .rail__expand,
  :global(html[data-sidebar='collapsed']) .rail__join {
    --rail-fade: opacity var(--t-fade) ease var(--t-fade);
    opacity: 1;
  }
  .rail__logo,
  .rail__join {
    transition: var(--rail-fade);
  }
  .rail__logo,
  .rail__expand,
  .rail__join {
    position: fixed;
    left: var(--gutter);
    z-index: 4;
  }
  .rail__logo {
    top: var(--nav-top);
    width: var(--rail-w);
    height: var(--rail-w);
  }
  .rail__expand {
    --icon-top: 14px;
    /* Above the "Join me:" group, which it overlaps in short windows. */
    z-index: 5;
    top: var(--content-top);
    width: var(--rail-w);
    height: var(--expand-h);
    overflow: hidden;
    transition:
      height var(--t-ctl) var(--ease-out),
      var(--rail-fade);
  }
  .rail__expand :global(svg) {
    position: absolute;
    left: 50%;
    top: var(--icon-top);
    transform: translateX(-50%);
    transition: top var(--t-ctl) var(--ease-out);
  }
  /*
   * Collapsed to an arrow-only square by default; grows to full height while hovered
   * or focused and shrinks back a couple of seconds after the pointer leaves, or right
   * away when the sidebar opens (<html data-expand-open>, set by scripts/sidebar.ts).
   */
  :global(html:not([data-expand-open])) .rail__expand {
    --icon-top: calc((var(--rail-w) - 4px - 30px) / 2);
    height: var(--rail-w);
  }
  /* Opened instantly when the sidebar closes on container 1 (scripts/sidebar.ts) — it
     still fades in with the rest of the rail. */
  :global(html[data-expand-instant]) .rail__expand {
    transition: var(--rail-fade);
  }
  :global(html[data-expand-instant]) .rail__expand :global(svg),
  :global(html[data-expand-instant]) .rail__expand-label {
    transition: none;
  }
  /* Collapsing hides the label at once; expanding fades it back in. */
  :global(html:not([data-expand-open])) .rail__expand-label {
    opacity: 0;
    transition: none;
  }
  .rail__expand-label {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    transition: opacity var(--t-ctl) ease;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: var(--ctl-font);
    letter-spacing: 0.04em;
  }
  .rail__join {
    bottom: var(--content-bottom);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rail__join-label {
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.055em;
    white-space: nowrap;
  }
  .rail__cta {
    width: var(--rail-w);
    height: var(--rail-w);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 2px solid var(--c-red);
    font-family: var(--f-ui);
    font-weight: 600;
    font-size: 8px;
    letter-spacing: 0.02em;
    transition:
      background-color var(--t-fade),
      border-color var(--t-fade),
      color var(--t-fade);
  }
  .rail__cta--primary {
    background: var(--c-red);
    color: var(--c-black);
  }
  /* Half-black fill so it reads over content passing under the rail (Games). */
  .rail__cta--outline {
    background: rgba(0, 0, 0, 0.5);
    color: var(--c-red);
  }
  .rail__cta--outline:hover {
    background: var(--c-red);
    color: var(--c-black);
  }
  .rail__cta--primary:hover,
  .rail__cta--primary:focus-visible {
    background: var(--c-white);
    border-color: var(--c-white);
    color: var(--c-black);
  }

  @media (max-width: 1279px) {
    /* Tablet: always shown. */
    .rail,
    :global(html[data-sidebar='collapsed']) .rail {
      visibility: visible;
      transition: none;
    }
    .rail__logo,
    .rail__expand,
    .rail__join {
      --rail-fade: opacity 0s;
      opacity: 1;
    }
    .rail__join-label {
      font-size: 14px;
    }
  }
  @media (max-width: 767px) {
    .rail {
      display: none;
    }
  }

  /* Start: no rail at all while the hero is in view (scripts/start.ts); it fades back in
     part by part once the explore row is (as when the sidebar collapses). Last, so it
     wins over the tablet rule above. */
  :global(html[data-hero-active]) .rail {
    visibility: hidden;
    transition: visibility 0s linear var(--t-fade);
  }
  :global(html[data-hero-active]) .rail__logo,
  :global(html[data-hero-active]) .rail__expand,
  :global(html[data-hero-active]) .rail__join {
    --rail-fade: opacity var(--t-fade) ease;
    opacity: 0;
  }
</style>
